<Window x:Class="HomekoWorld.Views.CalibrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomekoWorld.ViewModels"
        Title="Skill Barı Konfigüre Et"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

  <Border Padding="20">
    <StackPanel>

      <!-- Title + step indicator -->
      <Grid Margin="0,0,0,16">
        <TextBlock FontFamily="{StaticResource FontDisplay}"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource Gold}"
                   Text="Skill Barı Konfigürasyonu"
                   VerticalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource TextMuted}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Adım 1/3"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                  <Setter Property="Text" Value="Adım 2/3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                  <Setter Property="Text" Value="Adım 3/3"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- Status message -->
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource TextSoft}"
                 FontSize="12" TextWrapping="Wrap"
                 Margin="0,0,0,16"/>

      <!-- ═══ Step 1: bar count + slot count ═══ -->
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Kaç F-bar açık?" FontSize="11"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource InputMono}"
                     Text="{Binding BarCount, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="8,6"/>
            <TextBlock Text="1 – 8 arası" FontSize="10"
                       Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Her barda kaç slot?" FontSize="11"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource InputMono}"
                     Text="{Binding SlotCount, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="8,6"/>
            <TextBlock Text="1 – 10 arası" FontSize="10"
                       Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextDim}" Margin="0,0,0,16">
          Bir sonraki adımda oyun ekranınız görünecek. Skill barlarının
          bulunduğu dikdörtgen alanı fareyle sürükleyerek seçin.
        </TextBlock>

        <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right"
                Command="{Binding GoToAreaSelectionCommand}"
                Padding="16,7">Devam →</Button>
      </StackPanel>

      <!-- ═══ Step 2: area selection (passive — overlay handles it) ═══ -->
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <Border Style="{StaticResource PanelInset}" Padding="14" Margin="0,0,0,12">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSoft}">
            Ekran karartıldı. Skill barlarının tamamını kapsayan dikdörtgeni
            çizin. İptal etmek için Escape'e basın.
          </TextBlock>
        </Border>

        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                Command="{Binding CancelCommand}" Padding="12,6">İptal</Button>
      </StackPanel>

      <!-- ═══ Step 3: review unrecognized slots ═══ -->
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
          <ItemsControl ItemsSource="{Binding UnrecognizedSlots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6" Height="40">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                  </Grid.ColumnDefinitions>

                  <!-- Thumbnail -->
                  <Border Grid.Column="0" Width="36" Height="36"
                          BorderBrush="{StaticResource Border1}" BorderThickness="1"
                          CornerRadius="3" VerticalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                  </Border>

                  <!-- Slot key label -->
                  <TextBlock Grid.Column="1" Text="{Binding SlotKey}"
                             FontFamily="{StaticResource FontMono}" FontSize="12"
                             Foreground="{StaticResource TextSoft}"
                             VerticalAlignment="Center" Margin="4,0"/>

                  <!-- Skill pick button — opens SkillPickerDialog with search -->
                  <Button Grid.Column="2"
                          Style="{StaticResource BtnGhost}"
                          Tag="{Binding}"
                          Click="PickSkillButton_Click"
                          Margin="0,0,6,0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="7,4"
                          IsEnabled="{Binding IsEmpty, Converter={StaticResource InvertBoolConverter}}">
                    <TextBlock FontSize="11" VerticalAlignment="Center"
                               Text="{Binding SelectedSkill.NameTr, TargetNullValue='Seç…'}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSkill}" Value="{x:Null}">
                              <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>

                  <!-- Empty toggle -->
                  <CheckBox Grid.Column="3" VerticalAlignment="Center"
                            IsChecked="{Binding IsEmpty}"
                            Content="Boş" FontSize="11"
                            Foreground="{StaticResource TextMuted}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource BtnGhost}" Command="{Binding CancelCommand}"
                  Padding="12,6" Margin="0,0,8,0">İptal</Button>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding FinishCommand}"
                  Padding="16,6">Kaydet</Button>
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
