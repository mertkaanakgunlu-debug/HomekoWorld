<Window x:Class="HomekoWorld.Views.TestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Arayüzü — Timing Ölçüm"
        Width="860" Height="580"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        Closing="OnWindowClosing">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Toolbar ===== -->
    <Border Grid.Row="0" Height="48"
            Background="#FF0F0C08"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="70"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Kombo:" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" FontSize="11"/>

        <ComboBox Grid.Column="2" VerticalAlignment="Center"
                  Height="28"
                  ItemsSource="{Binding Combos}"
                  SelectedItem="{Binding SelectedCombo}"
                  DisplayMemberPath="Name"
                  Style="{StaticResource ComboBase}"/>

        <TextBlock Grid.Column="4" Text="Skip eşiği (ms):" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" FontSize="11"/>
        <TextBox Grid.Column="6" VerticalAlignment="Center" Height="28"
                 Text="{Binding SkipThresholdMs, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Bu değeri aşan olaylar skip sayılır"
                 Style="{StaticResource InputMono}"/>

        <Button Grid.Column="8" Padding="10,5" FontSize="11" VerticalAlignment="Center"
                Command="{Binding StartCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
              <Setter Property="Content"     Value="BAŞLAT"/>
              <Setter Property="Foreground"  Value="{StaticResource GoldBright}"/>
              <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2A4A1A" Offset="0"/>
                    <GradientStop Color="#FF1A3410" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                  <Setter Property="Foreground"  Value="{StaticResource TextDim}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
                  <Setter Property="Background"  Value="Transparent"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <Button Grid.Column="10" Padding="10,5" FontSize="11"
                VerticalAlignment="Center"
                Command="{Binding StopCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
              <Setter Property="Content"     Value="DURDUR"/>
              <Setter Property="Foreground"  Value="#FFFF6B6B"/>
              <Setter Property="BorderBrush" Value="#FF8B1414"/>
              <Setter Property="Visibility"  Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <Button Grid.Column="12" Content="TEMİZLE" Padding="10,5" FontSize="11"
                Style="{StaticResource BtnGhost}"
                VerticalAlignment="Center"
                Command="{Binding ClearCommand}"/>
      </Grid>
    </Border>

    <!-- ===== Content ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Left: live log -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0F0C08" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1" Padding="12,5">
          <TextBlock Text="CANLI LOG  (skip ve eşiğe yakın olaylar)"
                     Foreground="{StaticResource TextMuted}" FontSize="10"
                     FontFamily="{StaticResource FontMono}"/>
        </Border>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding LiveLog}"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource Text}"
                  FontFamily="{StaticResource FontMono}"
                  FontSize="11"
                  VirtualizingPanel.IsVirtualizing="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="It#"    DisplayMemberBinding="{Binding IterationNumber}" Width="42"/>
              <GridViewColumn Header="Plan"   DisplayMemberBinding="{Binding PlannedMs}"       Width="52"/>
              <GridViewColumn Header="Gerçek" DisplayMemberBinding="{Binding ActualMsStr}"     Width="58"/>
              <GridViewColumn Header="Δ ms"   DisplayMemberBinding="{Binding DeltaMsStr}"      Width="58"/>
              <GridViewColumn Header="Tuş"    DisplayMemberBinding="{Binding KeyName}"         Width="44"/>
              <GridViewColumn Header="Dir"    DisplayMemberBinding="{Binding ArrowStr}"        Width="28"/>
            </GridView>
          </ListView.View>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding"    Value="0"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSkip}" Value="True">
                  <Setter Property="Foreground" Value="#FFFF6B6B"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListView.ItemContainerStyle>
        </ListView>
      </Grid>

      <Rectangle Grid.Column="1" Fill="{StaticResource Divider}"/>

      <!-- Right: stats + chart -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats card -->
        <Border Grid.Row="0" Padding="14,10"
                Background="#FF0F0C08"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="PERFORMANS ÖZETİ"
                       Foreground="{StaticResource GoldBright}"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="İterasyon" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding IterationCount}"
                           Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource FontMono}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Başarı %" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding SuccessRate, StringFormat={}{0:F1}%}"
                           FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource FontMono}"
                           Foreground="{StaticResource GreenBright}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Skip" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding SkipCount}" Foreground="#FFFF6B6B"
                           FontSize="16" FontWeight="Bold"
                           FontFamily="{StaticResource FontMono}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Avg Δ ms" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding AvgDeviationMs, StringFormat={}{0:F2}}"
                           Foreground="{StaticResource Gold}"
                           FontSize="16" FontWeight="Bold"
                           FontFamily="{StaticResource FontMono}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="P95 ms" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding P95Ms, StringFormat={}{0:F1}}"
                           Foreground="{StaticResource TextSoft}"
                           FontFamily="{StaticResource FontMono}" FontSize="13"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="P99 ms" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding P99Ms, StringFormat={}{0:F1}}"
                           Foreground="{StaticResource TextSoft}"
                           FontFamily="{StaticResource FontMono}" FontSize="13"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Max ms" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Text="{Binding MaxDeviationMs, StringFormat={}{0:F1}}"
                           Foreground="{StaticResource TextSoft}"
                           FontFamily="{StaticResource FontMono}" FontSize="13"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Chart header -->
        <Border Grid.Row="1" Background="#FF0F0C08" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1" Padding="14,5">
          <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10"
                     FontFamily="{StaticResource FontMono}">
            <Run Text="SAPMA GRAFİĞİ  (max 30 ms)   "/>
            <Run Text="— eşik" Foreground="#AAFF6B6B"/>
          </TextBlock>
        </Border>

        <!-- Deviation chart -->
        <Grid Grid.Row="2" Margin="8,8,8,4" ClipToBounds="True">
          <!-- 110px tall chart zone (100 px data + 10px padding) -->
          <Grid Height="110" VerticalAlignment="Bottom">

            <!-- Threshold line: Border at ThresholdBarHeight from bottom -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Height="{Binding ThresholdBarHeight}"
                    BorderBrush="#AAFF6B6B" BorderThickness="0,1,0,0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10"/>

            <!-- Bars -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Hidden"
                          PanningMode="HorizontalOnly"
                          Panel.ZIndex="5">
              <ItemsControl ItemsSource="{Binding DeviationSamples}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Rectangle Width="4" Margin="0,0,1,0"
                               VerticalAlignment="Bottom"
                               Height="{Binding BarHeight}">
                      <Rectangle.Style>
                        <Style TargetType="Rectangle">
                          <Setter Property="Fill" Value="{StaticResource Gold}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSkip}" Value="True">
                              <Setter Property="Fill" Value="#FFFF6B6B"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Rectangle.Style>
                    </Rectangle>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="2" Height="28"
            Background="#FF0F0C08"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,1,0,0"
            Padding="12,0">
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource TextMuted}"
                 FontFamily="{StaticResource FontMono}"
                 FontSize="11"/>
    </Border>
  </Grid>
</Window>
