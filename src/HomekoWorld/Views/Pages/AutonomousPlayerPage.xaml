<UserControl x:Class="HomekoWorld.Views.Pages.AutonomousPlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- Başlık + açıklama -->
      <RowDefinition Height="*"/>      <!-- Kontroller (ScrollViewer ile) -->
      <RowDefinition Height="150"/>    <!-- Aktivite log (sabit min yükseklik) -->
    </Grid.RowDefinitions>

    <!-- ── Başlık ───────────────────────────────────────────────── -->
    <Border Grid.Row="0" Padding="14,12"
            BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
            Background="{StaticResource BgApp}">
      <StackPanel>
        <TextBlock Text="🤖 Otonom Oyuncu" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSoft}"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                   Foreground="{StaticResource TextMuted}"
                   Text="Farm sırasında envanteri izler; dolunca farmı durdurur, Town'a ışınlanır, eşyaları satar ve farm noktasına dönüp farma devam eder. Oto-Farm modunu kendisi açıp kapatır."/>
        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource Border1}" BorderThickness="1">
          <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextDim}"
                     Text="ⓘ Gereksinimler: YOLO modeli + HP bar kalibrasyonu. Tam döngü: Farm → envanter dolu → Town TP → Merchant → Sat → Tamir → Portal → Farm noktası → Farm. Sol menüden Otonom seç → F12 (ya da Başlat butonu) ile başlat/durdur. Tüm kalibrasyonlar ⚙ Ayarlar sayfasında."/>
        </Border>
      </StackPanel>
    </Border>

    <!-- ── Kontroller ───────────────────────────────────────────── -->
    <Border Grid.Row="1" Padding="14,12"
            BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
            Background="{StaticResource BgApp}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- ── Sınıf & Kombo: bu mod İÇİNDEN seçilebilir (her mod kendi başına kullanılabilir) ── -->
        <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="4"
                Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource Border1}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Sınıf" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
              <ComboBox Style="{StaticResource ComboBase}" FontSize="11"
                        ItemsSource="{Binding Classes}"
                        SelectedValue="{Binding CurrentClass, Mode=TwoWay}"
                        DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2">
                <Run Text="Kombo ("/><Run Text="{Binding CurrentClass}"/><Run Text=")"/>
              </TextBlock>
              <ComboBox Style="{StaticResource ComboBase}" FontSize="11"
                        ItemsSource="{Binding FarmAvailableCombos}"
                        SelectedValue="{Binding FarmSelectedComboId}"
                        DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Başlat / Durdur + Ayarlar -->
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding ToggleAutonomousCommand}"
                  Padding="12,9" FontSize="14" HorizontalAlignment="Left" MinWidth="220">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                <Setter Property="Foreground"  Value="{StaticResource GreenBright}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding AutonomousRunning}" Value="True">
                    <Setter Property="Foreground"  Value="{StaticResource RedBright}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource Green}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AutonomousRunning}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Red}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Active}" Value="False">
                        <Setter Property="Fill" Value="{StaticResource TextDim}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding AutonomousStartLabel}" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
          </Button>

          <!-- Kalibrasyonlar artık ⚙ Ayarlar sayfasında -->
          <Button Style="{StaticResource BtnMuted}" Margin="10,0,0,0"
                  Command="{Binding SelectPageCommand}" CommandParameter="settings"
                  Padding="12,9" FontSize="11"
                  ToolTip="Envanter, koordinat okuma, navigasyon, merchant satış/tamir, Town TP + portal ve NPC/portal tespiti kalibrasyonları Ayarlar sayfasına taşındı.">
            <TextBlock Text="⚙ Kalibrasyon &amp; Ayarlar" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>

        <!-- ── Ön-Uçuş Hazırlık: tüm zorunlu/önerilen kalibrasyon ve modeller ✓/✗ ──────────
             ZORUNLU eksikse Başlat engellenir (kenarlık kırmızı); yeşil = otonom başlatılabilir.
             Kullanıcı bir kalemi kalibre edince panel canlı güncellenir. -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                Background="{StaticResource BgPanel2}" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AutonomousReady}" Value="False">
                  <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="🚦 Ön-Uçuş Hazırlık" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding AutonomousReadiness}" FontSize="11" LineHeight="16"
                       FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Durum + FSM state -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Padding="8,5" CornerRadius="4"
                  Background="{StaticResource BgPanel2}"
                  BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Durum: " FontSize="11" Foreground="{StaticResource TextDim}"/>
              <TextBlock Text="{Binding AutonomousStateText}" FontSize="11" FontWeight="SemiBold"
                         FontFamily="{StaticResource FontMono}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AutonomousStateText}" Value="Farming">
                        <Setter Property="Foreground" Value="{StaticResource GreenBright}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding AutonomousStateText}" Value="Recovering">
                        <Setter Property="Foreground" Value="{StaticResource RedBright}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding AutonomousStateText}" Value="Idle">
                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Padding="8,5" CornerRadius="4"
                  Background="{StaticResource BgPanel2}"
                  BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <TextBlock Text="{Binding AutonomousStatus}" FontSize="11"
                       FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
        </Grid>

        <!-- Faz 37: Telemetri + kalibrasyon özeti -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Telemetri özeti -->
          <Border Grid.Column="0" Padding="8,5" CornerRadius="4"
                  Background="{StaticResource BgPanel2}"
                  BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <TextBlock Text="{Binding AutonomousTelemetrySummary}" FontSize="10"
                       FontFamily="{StaticResource FontMono}" Foreground="{StaticResource Gold}"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
          <!-- Ön-uçuş hazırlık (tek-satır özet; ayrıntı yukarıdaki panelde) -->
          <Border Grid.Column="2" Padding="8,5" CornerRadius="4"
                  Background="{StaticResource BgPanel2}"
                  BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <TextBlock Text="{Binding AutonomousReadinessHeader}" FontSize="10"
                       FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
        </Grid>

        <!-- HUD kısayolları — Otonom sayfasından da açılabilsin (HUD butonu yalnız combo
             sayfasının sağ panelindeydi; otonom modda oyun-üstü HUD için buraya eklendi) -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Command="{Binding ToggleFarmHudCommand}" Padding="9,5" FontSize="11" Margin="0,0,6,0"
                  ToolTip="Oyun üstü birleşik Ana HUD'u aç/kapat (combo + farm durumu).">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding FarmHudVisible}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                    <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="⬛ Ana HUD" FontSize="11"/>
          </Button>
          <Button Command="{Binding ToggleLogHudCommand}" Padding="9,5" FontSize="11"
                  ToolTip="Canlı aktivite Log HUD'unu aç/kapat.">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding LogHudVisible}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                    <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="📋 Log HUD" FontSize="11"/>
          </Button>
        </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ── Aktivite log ─────────────────────────────────────────── -->
    <Border Grid.Row="2" Padding="10" Background="{StaticResource BgApp}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="AKTİVİTE" Style="{StaticResource SectionHeader}"
                   Margin="2,0,0,6"/>
        <Border BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource BgPanel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
            <ItemsControl ItemsSource="{Binding AutonomousActivityLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="9"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextDim}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="10"
                               TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
