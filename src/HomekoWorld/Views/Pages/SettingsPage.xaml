                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0">
                    <Run Text="Menü eşiği: "/><Run Text="{Binding ClanBankMenuThreshold, StringFormat=F2}"/>
                  </TextBlock>
                  <Slider    Grid.Column="4" Minimum="0.50" Maximum="0.98" Value="{Binding ClanBankMenuThreshold}"
                             IsSnapToTickEnabled="True" TickFrequency="0.02" VerticalAlignment="Center"
                             ToolTip="Clan sekmesi/sandık template-locate eşiği; altında 'bulunamadı' → iptal."/>
                </Grid>

                <!-- Tuşlar -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Menü:" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,3,0"/>
                  <TextBox   Grid.Column="1" Style="{StaticResource InputBase}" FontSize="10"
                             Text="{Binding ClanBankMenuKey, UpdateSourceTrigger=LostFocus}"/>
                  <TextBlock Grid.Column="3" Text="Env:" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,3,0"/>
                  <TextBox   Grid.Column="4" Style="{StaticResource InputBase}" FontSize="10"
                             Text="{Binding ClanBankInventoryKey, UpdateSourceTrigger=LostFocus}"/>
                  <TextBlock Grid.Column="6" Text="Kapat:" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,3,0"/>
                  <TextBox   Grid.Column="7" Style="{StaticResource InputBase}" FontSize="10"
                             Width="110" HorizontalAlignment="Left"
                             Text="{Binding ClanBankCloseKey, UpdateSourceTrigger=LostFocus}"
                             ToolTip="'toggle' = U ile menüyü, I ile envanteri kapat (Esc kill-switch footgun'ından kaçınır). Ya da bir tuş (ör. Escape)."/>
                </Grid>

                <!-- Clan sekmesi -->
