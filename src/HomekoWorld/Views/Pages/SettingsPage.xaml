                             Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Test -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource BtnMuted}"
