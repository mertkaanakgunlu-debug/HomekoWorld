                          Padding="7,3" FontSize="10">🔎 Test Tara</Button>
                  <TextBlock Grid.Column="2" Text="{Binding InventoryStatus}" FontSize="10"
                             FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ════════════ 5 · KOORDİNAT &amp; NAVİGASYON ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat5, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="📍 Koordinat Okuma"/>
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                           Text="Glyph eşleştirme — eğitim/model dosyası YOK. 1) X ve Y sayılarının üstüne ayrı dikdörtgen çiz. 2) Oyundaki değerleri yazıp 'Rakamları Öğret' ile her rakamı bir kez tanıt (0-9 hepsi öğrenilene dek farklı sayılarla tekrarla). 3) 'Oku' ile doğrula."/>

