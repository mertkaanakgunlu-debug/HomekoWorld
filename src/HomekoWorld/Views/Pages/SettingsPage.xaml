                  <TextBlock Grid.Column="0" Text="Boşta (sn):" VerticalAlignment="Center" FontSize="10"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,4,0"/>
                  <TextBox   Grid.Column="1" Style="{StaticResource InputBase}" FontSize="10"
                             Width="64" HorizontalAlignment="Left"
                             Text="{Binding FarmReturnHomeIdleSec, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Bu kadar saniye hiç hedef seçilmez/savaşılmazsa dönülür (varsayılan 20)."/>
                  <TextBlock Grid.Column="3" Text="Min sapma:" VerticalAlignment="Center" FontSize="10"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,4,0"/>
                  <TextBox   Grid.Column="4" Style="{StaticResource InputBase}" FontSize="10"
                             Width="64" HorizontalAlignment="Left"
                             Text="{Binding FarmReturnHomeStray, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Eve bu kadar oyun-biriminden yakınsa dönüş yapılmaz (boşa yürüme yok; varsayılan 30)."/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ════════════ 3 · KLAN BANKASI ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat3, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="🏦 Klan Bankası (Envanter Boşaltma)"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Envanter dolunca eşyaları klan bankasına aktarır: U menü → Clan → sandık → depolanabilir eşyalara sağ-tık. Menü ögeleri şablonla (template) bulunur; önce şablonları öğret."/>

            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <CheckBox Content="🏦 Envanter dolunca klan bankasına boşalt"
                          IsChecked="{Binding ClanBankEnabled}"
                          Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"
                          ToolTip="Her N kill'de envanter kontrol edilir; doluysa U menü → Clan → sandık → depolanabilir eşyalara sağ-tık. Menü ögeleri template-match ile bulunur."/>

                <Border Padding="6,3" CornerRadius="4" Margin="0,0,0,6"
                        Background="{StaticResource BgInset}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
                  <TextBlock Text="{Binding ClanBankStatus}" FontFamily="{StaticResource FontMono}"
                             FontSize="10" Foreground="{StaticResource Gold}" TextWrapping="Wrap"/>
                </Border>

                <!-- Tetik + eşikler -->
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
