<UserControl x:Class="HomekoWorld.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- Sol kategori menüsü butonu: seçili = altın vurgulu satır -->
    <Style x:Key="CatBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="SettingsCat"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="6" Padding="10,8" Margin="0,1"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background"  Value="#1AD4A44A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Gold}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Ayar kartı (sayfa genelinde tekrar eden çerçeve) -->
    <Style x:Key="SettingCard" TargetType="Border">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border1}"/>
      <Setter Property="Background" Value="{StaticResource BgPanel2}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Kategori içi bölüm başlığı -->
    <Style x:Key="CatSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── Başlık ──────────────────────────────────────────────── -->
    <Border Grid.Row="0" Padding="14,12"
            BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
            Background="{StaticResource BgApp}">
      <StackPanel>
        <TextBlock Text="⚙ Ayarlar &amp; Kalibrasyon" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSoft}"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                   Foreground="{StaticResource TextMuted}"
                   Text="Tüm kalibrasyonlar ve gelişmiş ayarlar burada. Soldan bir kategori seç; her adımın yanında ✓/✗ durumu görünür. Kalibrasyonlar kaydedilir — bir kez yapman yeterli."/>
      </StackPanel>
    </Border>

    <!-- ── Sol menü + içerik ───────────────────────────────────── -->
    <Grid Grid.Row="1" Background="{StaticResource BgApp}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="185"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Kategori menüsü -->
      <Border Grid.Column="0" Padding="8,10"
              BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0"
              Background="{StaticResource BgPanel}">
        <StackPanel>
          <RadioButton x:Name="Cat0" Style="{StaticResource CatBtn}" IsChecked="True" Content="🎯 Temel Kalibrasyon"/>
          <RadioButton x:Name="Cat1" Style="{StaticResource CatBtn}" Content="📦 Model &amp; Tespit"/>
          <RadioButton x:Name="Cat2" Style="{StaticResource CatBtn}" Content="🌾 Oto Farm"/>
          <RadioButton x:Name="Cat3" Style="{StaticResource CatBtn}" Content="🏦 Klan Bankası"/>
          <RadioButton x:Name="Cat4" Style="{StaticResource CatBtn}" Content="🎒 Envanter"/>
          <RadioButton x:Name="Cat5" Style="{StaticResource CatBtn}" Content="📍 Koordinat &amp; Nav"/>
          <RadioButton x:Name="Cat6" Style="{StaticResource CatBtn}" Content="🏙 Kasaba (Satış/Portal)"/>
          <RadioButton x:Name="Cat7" Style="{StaticResource CatBtn}" Content="⚙ Genel"/>
        </StackPanel>
      </Border>

      <!-- İçerik — tek-satır TextBox'lar wheel'i yutmasın diye preview'de yakala -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="AdvScroll_PreviewMouseWheel">
        <Grid Margin="14,12,14,16" MaxWidth="820" HorizontalAlignment="Left">

          <!-- ════════════ 0 · TEMEL KALİBRASYON ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat0, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="🎯 Temel Kalibrasyon"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Botun ekranı okuyabilmesi için gereken temel adımlar. Kendi HP/MP barını ve hedef mob HP barını İKİ KÖŞE tıklayarak öğret (bar dolu olması gerekmez). Karakter merkezi otomatiktir (ekran ortası)."/>

            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Text="ANA KALİBRASYON" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Command="{Binding CalibrateFarmCenterCommand}"
                          Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="11"
                          ToolTip="3 adım: Kendi HP, MP ve Mob HP barını ikişer köşeden seçerek kalibre et">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⊕ " FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="Ana Kalibrasyon (HP / MP / Mob HP)" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Command="{Binding CalibrateAnnounceShiftCommand}"
                          Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="11"
                          ToolTip="Duyuru geldiğinde kayan Mob HP barının sol-üst köşesine tek tıkla">
                    <TextBlock Text="Duyuru Δy" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding FarmCalibrationState}"
                           FontSize="10" Foreground="{StaticResource Gold}"
                           TextWrapping="Wrap" Margin="0,6,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FarmCalibrationState}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- Hedef HP Bar -->
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Text="🎯 Hedef HP Bar" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                <!-- Tespit yöntemi: Hsv (varsayılan, hızlı) / ColorScan (RGB) -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Yöntem" FontSize="10" VerticalAlignment="Center"
                             Foreground="{StaticResource TextMuted}"/>
                  <ComboBox Grid.Column="2" Style="{StaticResource ComboBase}" FontSize="10"
                            ItemsSource="{Binding HpBarModeOptions}"
                            SelectedItem="{Binding FarmHpBarMode}"
                            ToolTip="Hsv: hızlı kırmızı-oran tespiti (varsayılan, önerilen). ColorScan: RGB renk taraması."/>
                </Grid>

                <!-- Mob HP barı önizleme görüntüsü -->
                <Border Margin="0,0,0,4" BorderThickness="1"
                        BorderBrush="{StaticResource Border1}"
                        Visibility="{Binding HpColorScanPreviewVisible,
                                     Converter={StaticResource BoolToVis}}">
                  <Image Source="{Binding HpColorScanPreview}"
                         Stretch="Uniform" MaxHeight="80"
                         RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <!-- Mob HP barı koordinatları -->
                <TextBlock Text="{Binding HpBarRoiPreviewStatus}"
                           FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                           Foreground="{StaticResource Gold}"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Button Grid.Column="0" Command="{Binding PreviewHpColorScanAreaCommand}"
                          Style="{StaticResource BtnMuted}" Padding="7,3" FontSize="10"
                          ToolTip="Ana kalibrasyon mob HP barı adımının (iki-köşe) taradığı alanı göster">
                    <TextBlock Text="📷 Önizle"/>
                  </Button>

                  <!-- Renk tarama fallback — küçük kırmızı buton -->
                  <Button Grid.Column="2" Command="{Binding CalibrateTargetHpColorCommand}"
                          Padding="6,3" FontSize="9"
                          Background="#33FF3333" BorderBrush="#66FF3333" Foreground="#FFCC6666"
                          ToolTip="{Binding TargetHpColorCalibStatus}">
                    <TextBlock Text="🔴 Renk fallback"/>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

            <!-- V4 — Hedef Penceresi Çerçevesi (yapı-tabanlı seçili/canlı/öldü) -->
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Text="🧩 Hedef Penceresi Çerçevesi (yapı-tabanlı, önerilen)" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                <TextBlock FontSize="9" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Hedef seçiliyken barın HP'den bağımsız SABİT bir parçasına (çerçeve/köşe süsü — kırmızı/oluk alanına taşmadan) kutu çiz. Öğretilirse seçili/canlı/öldü artık renk yerine bu yapıdan okunur (daha sağlam); öğretilmezse mevcut renk yöntemi aynen çalışır."/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Command="{Binding CalibrateTargetFrameRoiCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Arama Bölgesi</Button>
                  <Button Command="{Binding TeachTargetFrameTemplateCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Şablon Öğret</Button>
                  <Button Command="{Binding ResetTargetFrameCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Sıfırla</Button>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Command="{Binding TestTargetFrameTemplateCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">🔎 Test</Button>
                  <TextBlock Grid.Column="1" Text="{Binding TargetFrameStatus}" FontSize="10" FontFamily="{StaticResource FontMono}"
                             Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0">
                    <Run Text="VAR eşiği: "/><Run Text="{Binding TargetFrameMatchThreshold, StringFormat=F2}"/>
                  </TextBlock>
                  <Slider Grid.Column="1" Minimum="0.50" Maximum="0.98" Value="{Binding TargetFrameMatchThreshold}"
                          IsSnapToTickEnabled="True" TickFrequency="0.02" VerticalAlignment="Center"
                          ToolTip="Bu skorun üzerinde çerçeve 'VAR' (pencere açık) sayılır."/>
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0">
                    <Run Text="YOK eşiği: "/><Run Text="{Binding TargetFrameAbsentThreshold, StringFormat=F2}"/>
                  </TextBlock>
                  <Slider Grid.Column="4" Minimum="0.30" Maximum="0.90" Value="{Binding TargetFrameAbsentThreshold}"
                          IsSnapToTickEnabled="True" TickFrequency="0.02" VerticalAlignment="Center"
                          ToolTip="Bu skorun altında çerçeve 'YOK' sayılır (arada histerezis: önceki durum korunur)."/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Koruma Mobu İsim Rengi Kalibrasyonu -->
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Text="🛡 Koruma Mobu İsim Tespiti (HSV)" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                <!-- İsim bandı önizleme görüntüsü -->
                <Border Margin="0,0,0,4" BorderThickness="1"
                        BorderBrush="{StaticResource Border1}"
                        Visibility="{Binding NameBandPreviewVisible,
                                     Converter={StaticResource BoolToVis}}">
                  <Image Source="{Binding NameBandPreview}"
                         Stretch="Uniform" MaxHeight="80"
                         RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <!-- İsim bandı koordinatları -->
                <TextBlock Text="{Binding NameBandCalibStatus}"
                           FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                           Foreground="{StaticResource Gold}"/>

                <!-- Bant çiz + önizle (HP bar ROI kalibrasyonuyla aynı UX) -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Command="{Binding CalibrateNameBandCommand}"
                          Style="{StaticResource BtnMuted}" Padding="7,3" FontSize="10"
                          ToolTip="İsim metninin üzerine dikdörtgen çiz — kırmızı tespiti bu bandı tarar">
                    <TextBlock Text="🖊 İsim Bandını Çiz"/>
                  </Button>
                  <Button Grid.Column="2" Command="{Binding PreviewNameBandCommand}"
                          Style="{StaticResource BtnMuted}" Padding="7,3" FontSize="10"
                          ToolTip="Çizilen bandın doğru yeri kapsadığını gör">
                    <TextBlock Text="📷 Önizle"/>
                  </Button>
                </Grid>

                <!-- Opsiyonel: RGB renk referansı (HSV tespiti için gerekmez) -->
                <TextBlock Text="Opsiyonel renk referansı (HSV için gerekmez):" FontSize="9"
                           Foreground="{StaticResource TextDim}" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Command="{Binding CalibrateNormalNameCommand}"
                          Style="{StaticResource BtnMuted}"
                          Padding="7,3" FontSize="10"
                          ToolTip="Normal (mor) mob isminin üzerine tıklayın — renk referansı alınır">
                    <TextBlock Text="📍 Normal (Mor)"/>
                  </Button>
                  <Button Grid.Column="2" Command="{Binding CalibrateGuardianNameCommand}"
                          Style="{StaticResource BtnMuted}"
                          Padding="7,3" FontSize="10"
                          ToolTip="Koruma (kırmızı) mob isminin üzerine tıklayın — renk referansı alınır">
                    <TextBlock Text="📍 Koruma (Kırmızı)"/>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding NameplateCalibStatus}"
                           FontSize="9" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ════════════ 1 · MODEL &amp; TESPİT ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat1, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="📦 Model &amp; Tespit"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Mob tanıma modeli (YOLO .onnx) ve tespit eşikleri. Kurulumla birlikte gelir — genelde 'Otomatik Bul' yeterlidir."/>

            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <!-- Otomatik bul -->
                <Button Command="{Binding AutoDiscoverFarmFilesCommand}"
                        Style="{StaticResource BtnMuted}"
                        Padding="6,4" FontSize="10" Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        ToolTip="mobs.json ve best.onnx dosyalarını otomatik bul">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳ " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Dosyaları Otomatik Bul" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <!-- mobs.json -->
                <TextBlock Text="mobs.json" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource InputBase}"
                           FontSize="10" IsReadOnly="True"
                           Text="{Binding FarmMobsJsonPath, Mode=OneWay}"
                           Padding="4,3" Margin="0,0,4,0"/>
                  <Button Grid.Column="1" Style="{StaticResource BtnMuted}"
                          Command="{Binding BrowseMobsJsonCommand}"
                          Padding="6,3" FontSize="10">Seç…</Button>
                </Grid>

                <!-- YOLO model -->
                <TextBlock Text="YOLO Modeli (.onnx)" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource InputBase}"
                           FontSize="10" IsReadOnly="True"
                           Text="{Binding FarmModelPath, Mode=OneWay}"
                           Padding="4,3" Margin="0,0,4,0"/>
                  <Button Grid.Column="1" Style="{StaticResource BtnMuted}"
                          Command="{Binding BrowseModelCommand}"
                          Padding="6,3" FontSize="10">Seç…</Button>
                </Grid>

                <!-- Model hazır badge -->
                <Border Padding="6,3" CornerRadius="4"
                        Background="{StaticResource BgInset}"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1">
                  <TextBlock Text="{Binding FarmStatus}"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="10" Foreground="{StaticResource TextMuted}"
                             TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <!-- T1: YOLO güven eşiği — düşük = daha çok tespit (ağaç riski), yüksek = yalnız emin olunan moblar -->
                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                  <Run Text="🔍 YOLO güven eşiği: "/><Run Text="{Binding FarmConfidence, StringFormat=F2}"/><Run Text="  (düşük = çok kutu / yüksek = emin)"/>
                </TextBlock>
                <Slider Minimum="0.30" Maximum="0.90" Value="{Binding FarmConfidence}"
                        IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.10"
                        ToolTip="Bu skorun altındaki YOLO tespitleri elenir. Ağaçları/yanlış nesneleri mob sanıyorsa BÜYÜT (0.55-0.65). Gerçek mobları kaçırıyorsa KÜÇÜLT. Değişiklik anında uygulanır (yeniden model yükleme gerekmez)."/>

                <!-- A6: NMS IoU eşiği — dip-dibe moblarda iki kutunun birbirini bastırmasını ayarlar -->
                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0">
                  <Run Text="🔗 NMS IoU eşiği: "/><Run Text="{Binding FarmIou, StringFormat=F2}"/><Run Text="  (yüksek = dip-dibe ayrı kutu)"/>
                </TextBlock>
                <Slider Minimum="0.20" Maximum="0.80" Value="{Binding FarmIou}"
                        IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.10"
                        ToolTip="İç içe iki tespitten birini elemenin eşiği. Dip-dibe moblar TEK kutu oluyorsa BÜYÜT (0.55-0.65). Aynı moba ÇİFT kutu çıkıyorsa KÜÇÜLT (0.40-0.45). Değişiklik anında uygulanır."/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ════════════ 2 · OTO FARM ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat2, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="🌾 Oto Farm Davranışı"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Farm sırasında botun nasıl davranacağı: archer yaklaşması, tespit kutuları, performans seçenekleri ve farm lokasyonuna dönüş."/>

            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Text="⚙ Farm Davranışı" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <!-- Archer Modu — 13.tur (P5): her sınıfta GÖRÜNÜR (eskiden yalnız archer'da görünüyordu;
                     ayar takılı kalınca kullanıcı kapatamıyor, log kafa karıştırıyordu). Archer-dışı
                     sınıfta ayar zaten ETKİSİZDİR (sınıf-gate) — aşağıdaki uyarı bunu açıkça söyler. -->
                <StackPanel>
                  <CheckBox IsChecked="{Binding FarmArcherMode}"
                            Foreground="{StaticResource TextMuted}" FontSize="10"
                            Margin="0,0,0,2"
                            Content="🏹 Archer modu (yaklaş + yönelerek vur)"
                            ToolTip="KAPALI (önerilen, archer dışı tüm sınıflar): hedef seçilince kombo hemen ateşlenir, oyun karakteri hedefe götürür. AÇIK (archer): AoE oklarının değmesi için moba yaklaşır (W sürekli basılı akıcı koşu) — hedef etrafında dönmeden menzile girince vurur. Yalnız sınıf ARCHER iken etkilidir; diğer sınıflarda yok sayılır."/>
                  <TextBlock FontSize="10" Foreground="#E8B14A" TextWrapping="Wrap" Margin="18,0,0,2"
                             Text="⚠ Sınıf archer değil — bu ayar şu an ETKİSİZ (kombo, yaklaşmayı oyun içinde kendisi yapar).">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CurrentClass}" Value="archer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FarmArcherMode}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Margin="18,2,0,4" IsEnabled="{Binding FarmArcherMode}">
                    <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                      <Run Text="Yaklaşma mesafesi: "/><Run Text="{Binding FarmArcherRangePx}"/><Run Text=" px (küçük = daha yakın)"/>
                    </TextBlock>
                    <Slider Minimum="40" Maximum="220" Value="{Binding FarmArcherRangePx}"
                            IsSnapToTickEnabled="True" TickFrequency="5" SmallChange="5" LargeChange="20"
                            ToolTip="Archer komboya başlamadan önce moba ne kadar yaklaşsın (ekran px). 'Yeterince yaklaşmıyor' diyorsan KÜÇÜLT; 'çok dibine giriyor' diyorsan BÜYÜT. Çözünürlük/zoom'a göre test ederek ayarla."/>
                  </StackPanel>
                </StackPanel>
                <!-- 13.tur (S3): nüfus muhasebesi — tüm moblar kill-borçluyken hareketsiz kutular ceset sayılır, tıklanmaz -->
                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0">
                  <Run Text="👥 Bölge mob sayısı: "/><Run Text="{Binding FarmRegionMobCount}"/><Run Text="  (0 = kapalı)"/>
                </TextBlock>
                <Slider Minimum="0" Maximum="15" Value="{Binding FarmRegionMobCount}"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ToolTip="Farm bölgesindeki normal (avlanan) mob sayısı; koruma mobu SAYILMAZ. Tüm moblar kesilmişken (respawn bekleniyor) ekranda kalan hareketsiz kutular ceset sayılır ve tıklanmaz — boşa tıklama/takılma azalır. Farklı spota geçince güncelle. 0 = özellik kapalı."/>
                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
