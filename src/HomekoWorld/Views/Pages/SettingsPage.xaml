                <TextBlock Text="{Binding ClanBankChestInvStatus}" FontFamily="{StaticResource FontMono}"
                           FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,2"/>
