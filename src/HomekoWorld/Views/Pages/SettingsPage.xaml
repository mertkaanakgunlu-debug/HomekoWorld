                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource InputBase}" FontSize="10"
                           Text="{Binding ClanBankNewItemType, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Tür adı (ör. 4m coin)…" Margin="0,0,4,0"/>
                  <Button Grid.Column="1" Command="{Binding AddClanBankItemTypeCommand}" Style="{StaticResource BtnMuted}" Padding="6,3" FontSize="10">+ Tür Ekle</Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ClanBankItemTypes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <Button Grid.Column="1" Content="Öğret" Style="{StaticResource BtnMuted}" Padding="5,2" FontSize="10" Margin="0,0,4,0"
                                Command="{Binding DataContext.TeachClanBankItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Name}"/>
                        <Button Grid.Column="2" Content="Sil" Style="{StaticResource BtnMuted}" Padding="5,2" FontSize="10"
                                Command="{Binding DataContext.RemoveClanBankItemTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Name}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Görsel teşhis (2026-07-03): sandık açıkken skorlu grid dökümü + oto-döküm -->
                <TextBlock Text="Görsel teşhis — sandık/envanter AÇIKKEN çalıştır: her yuvanın eşleşme skoru clan_bank_debug.png'ye çizilir"
                           FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <Button Command="{Binding TestClanBankScanCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">🔬 Teşhis (sandık açıkken)</Button>
                  <Button Command="{Binding OpenClanBankDiagFolderCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Klasörü Aç</Button>
                </StackPanel>
                <CheckBox IsChecked="{Binding ClanBankAutoDump}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
                          Content="Eşleşme 0 ise otomatik döküm al (banka çalışırken)"/>

                <TextBlock FontSize="9" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Not: envanter ızgarası 🎒 Envanter kategorisindeki kalibrasyondan alınır (tek envanter kalibrasyonu). Menü tuşları oyunla eşleşmeli."/>
              </StackPanel>
            </Border>
          </StackPanel>

