                  <Button Command="{Binding CalibrateChestInvGridCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Kalibre Et</Button>
                  <Button Command="{Binding ResetChestInvGridCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Sıfırla (Otonom'unkine dön)</Button>
                </StackPanel>

                <!-- Depolanabilir eşya türleri -->
                <TextBlock Text="Depolanabilir eşya türleri (tür-başına örnek öğret: 4m, 2m, 1m, parşömen…)"
