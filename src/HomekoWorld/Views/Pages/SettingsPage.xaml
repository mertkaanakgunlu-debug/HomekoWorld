              <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                           Text="Her N kill'de envanter açılır; ızgara (28 yuva — satır/sütun yönü ROI en-boy oranından otomatik; bu oyunda 7×4) parlaklık+renk taraması ile yuva doluluğu ölçülür. Eşiği aşınca farm durur ve GoingToTown geçişi yapar. Önce ızgara ROI'sini kalibre edin. Klan bankası da AYNI ızgarayı kullanır."/>

                <!-- Izgara kalibrasyon -->
                <TextBlock Text="{Binding InventoryGridStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                           Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Button Style="{StaticResource BtnMuted}" Command="{Binding CalibrateInventoryGridCommand}"
                        Padding="5,3" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,8">
                  🖊 Izgara ROI Kalibre
                </Button>

                <!-- Ayarlar -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Envanter tuşu" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding InventoryKey, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Her N kill'de kontrol" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding InventoryCheckEveryKills, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </Grid>

