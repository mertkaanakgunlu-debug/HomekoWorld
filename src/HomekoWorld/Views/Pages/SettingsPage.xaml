                    <Run Text="Doluluk eşiği: "/><Run Text="{Binding ClanBankFullThreshold, StringFormat=F2}"/>
                  </TextBlock>
                  <Slider    Grid.Column="4" Minimum="0.50" Maximum="1.00" Value="{Binding ClanBankFullThreshold}"
                             IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0">
                    <Run Text="Eşya eşiği: "/><Run Text="{Binding ClanBankItemThreshold, StringFormat=F2}"/>
                  </TextBlock>
                  <Slider    Grid.Column="1" Minimum="0.50" Maximum="0.98" Value="{Binding ClanBankItemThreshold}"
                             IsSnapToTickEnabled="True" TickFrequency="0.02" VerticalAlignment="Center"
