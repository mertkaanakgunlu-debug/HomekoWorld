                  <Button Command="{Binding CalibrateStorageOpenRoiCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Arama Bölgesi</Button>
                  <Button Command="{Binding TeachStorageOpenTemplateCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Şablon Öğret</Button>
                  <Button Command="{Binding ResetStorageOpenCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Sıfırla</Button>
                </StackPanel>

                <!-- Sandık açıkken envanter ızgarası (opsiyonel) -->
