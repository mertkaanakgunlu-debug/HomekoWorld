                  <Button Command="{Binding CalibrateClanTabRoiCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Arama Bölgesi</Button>
                  <Button Command="{Binding TeachClanTabTemplateCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Şablon Öğret</Button>
                  <Button Command="{Binding ResetClanTabCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Sıfırla</Button>
                </StackPanel>

                <!-- Hazine sandığı -->
                <TextBlock Text="Hazine sandığı (template)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Command="{Binding CalibrateChestRoiCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Arama Bölgesi</Button>
                  <Button Command="{Binding TeachChestTemplateCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,4,0">Şablon Öğret</Button>
                  <Button Command="{Binding ResetChestCommand}" Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10">Sıfırla</Button>
                </StackPanel>

                <!-- Depo penceresi doğrulama (opsiyonel) -->
                <TextBlock Text="Depo penceresi doğrulama (opsiyonel)" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,2,0,2"/>
