                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateCoordXRoiCommand}"
                          Padding="5,3" FontSize="10">🖊 X ROI çiz</Button>
                  <Button Grid.Column="2" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateCoordYRoiCommand}"
                          Padding="5,3" FontSize="10">🖊 Y ROI çiz</Button>
                </Grid>
                <TextBlock Text="{Binding CoordXRoiStatus}" FontSize="9" Foreground="{StaticResource TextDim}"/>
                <TextBlock Text="{Binding CoordYRoiStatus}" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>

                <!-- Birleşik ROI (önerilen) — tek geniş kutu "X, Y", virgülden böler -->
                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource Gold}" Margin="0,2,0,4"
                           Text="★ ÖNERİLEN: ayrı X/Y yerine TEK geniş ROI çiz (tüm 'X, Y'yi virgül dahil kapsa). Hane 3↔4 değişince ayrı ROI'ler kayar; birleşik ROI virgülden böldüğü için her durumda doğru okur. Aşağıda X ve Y'yi yazıp 'Öğret' deyince virgülü de otomatik öğrenir."/>
                <Button Style="{StaticResource BtnMuted}" Command="{Binding CalibrateCoordComboRoiCommand}"
                        Padding="5,3" FontSize="10" HorizontalAlignment="Left">🖊 Birleşik ROI çiz (X, Y)</Button>
                <TextBlock Text="{Binding CoordComboRoiStatus}" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,2,0,4"/>

                <!-- ROI önizleme -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                            Visibility="{Binding CoordPreviewVisible, Converter={StaticResource BoolToVis}}">
                  <Border BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,0,6,0">
                    <Image Source="{Binding CoordXPreview}" Stretch="None" MaxHeight="40"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                  </Border>
                  <Border BorderBrush="{StaticResource Border1}" BorderThickness="1">
                    <Image Source="{Binding CoordYPreview}" Stretch="None" MaxHeight="40"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                  </Border>
                </StackPanel>
                <Button Style="{StaticResource BtnMuted}" Command="{Binding PreviewCoordRoisCommand}"
                        Padding="5,3" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,8">📷 ROI Önizle</Button>

                <!-- Segmentasyon ayarları + teşhis -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <CheckBox Content="Tersine Çevir" FontSize="9" VerticalAlignment="Center"
                            Foreground="{StaticResource TextDim}" Margin="0,0,12,0"
                            IsChecked="{Binding CoordBinInvert}"/>
                  <TextBlock Text="Min Boşluk:" FontSize="9" VerticalAlignment="Center"
                             Foreground="{StaticResource TextDim}" Margin="0,0,4,0"/>
                  <TextBox Style="{StaticResource InputMono}" FontSize="9" Width="28"
                           Text="{Binding CoordMinGapPx, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="px" FontSize="9" VerticalAlignment="Center"
                             Foreground="{StaticResource TextDim}" Margin="2,0,10,0"/>
                  <TextBlock Text="Min Güven:" FontSize="9" VerticalAlignment="Center"
                             Foreground="{StaticResource TextDim}" Margin="0,0,4,0"/>
                  <TextBox Style="{StaticResource InputMono}" FontSize="9" Width="38"
                           Text="{Binding CoordMinConfidence, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="" FontSize="9" VerticalAlignment="Center"
                             Foreground="{StaticResource TextDim}" Margin="2,0,10,0"/>
                  <Button Style="{StaticResource BtnMuted}" Command="{Binding DiagnoseCoordCommand}"
                          Padding="5,2" FontSize="9">🔬 Teşhis</Button>
                </StackPanel>

                <!-- Rakamları öğret (glyph) -->
                <TextBlock Text="{Binding CoordGlyphStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Rakamları öğret — oyundaki X/Y değerini yaz, sonra Öğret:" FontSize="9"
                           Foreground="{StaticResource TextDim}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="X:" FontSize="10" VerticalAlignment="Center"
                             Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
                  <TextBox Grid.Column="1" Style="{StaticResource InputMono}" FontSize="10"
                           Text="{Binding CoordSampleX, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Column="3" Text="Y:" FontSize="10" VerticalAlignment="Center"
                             Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
                  <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                           Text="{Binding CoordSampleY, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                  <Button Style="{StaticResource BtnMuted}" Command="{Binding TeachDigitsCommand}"
                          Padding="5,3" FontSize="10" Margin="0,0,6,0">🎓 Rakamları Öğret</Button>
                  <Button Style="{StaticResource BtnMuted}" Command="{Binding ResetGlyphsCommand}"
                          Padding="5,3" FontSize="10">🗑 Sıfırla</Button>
                </StackPanel>
                <TextBlock Text="{Binding CoordCaptureStatus}" FontSize="9" Foreground="{StaticResource TextDim}"
                           Margin="0,3,0,8" TextWrapping="Wrap"/>

                <!-- Canlı oku -->
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding ReadCoordOnceCommand}"
                          Padding="5,3" FontSize="10">🔎 Oku (tek)</Button>
                  <TextBlock Grid.Column="2" Text="{Binding CoordLiveRead}" FontSize="12"
                             FontFamily="{StaticResource FontMono}" Foreground="{StaticResource Gold}"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Kararlılık & hız testi (navigasyonun ön-koşulu: okuma hızlı + tutarlı olmalı) -->
                <Button Style="{StaticResource BtnMuted}" Command="{Binding CoordStabilityTestCommand}"
                        Padding="5,3" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Left"
                        ToolTip="Sabit dururken 30 okuma yapar; hız (okuma/sn) ve tutarlılık (hane-düşmesi var mı) raporlar">⏱ Kararlılık &amp; Hız Testi</Button>
                <TextBlock Text="{Binding CoordStabilityStatus}" FontSize="9" Foreground="{StaticResource TextDim}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CatSection}" Text="🗺 Navigasyon" Margin="0,6,0,6"/>
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"
                           Text="Adaptif akıcı navigasyon: W sürekli basılı, karakter yürürken A/D kısa tap ile hedefe doğru KIVRILIR. Konum güvenilir okunur (hane-düşmesi/çöp elenir); okuma tıkanırsa kısa durup okur. Dönüş yönü çalışırken kendini düzeltir. Önce ⏱ Kararlılık testi'ni geç."/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Yürüme/okuma adımı (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding NavContinuousReadMs, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Bir segmentte ne kadar yürünsün — yüksek=uzun adım/daha akıcı, düşük=sık dur/düzelt (en az 200)"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Dönüş kazancı (0.1-1.5)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding NavContinuousSteerGain, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Açı hatasının ne kadarı her düzeltmede dönülsün. Salınıyorsa düşür; yavaş yönelir/dışa çiziyorsa artır"/>
                  </StackPanel>
                </Grid>

                <!-- A/D dönüş hızı -->
                <TextBlock Text="Karakter dönüş hızı (ms/derece)" FontSize="9"
                           Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="2" Maximum="30" TickFrequency="0.5"
                          IsSnapToTickEnabled="True" VerticalAlignment="Center"
                          Value="{Binding NavTurnMsPerDeg}"/>
                  <TextBlock Grid.Column="2" Text="{Binding NavTurnMsPerDeg, StringFormat={}{0:0.0}}"
                             FontSize="10" FontFamily="{StaticResource FontMono}"
                             Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                  <Button Grid.Column="4" Style="{StaticResource BtnMuted}"
                          Command="{Binding CalibrateTurnRateCommand}"
                          Padding="5,2" FontSize="9">🔧 Kalibre (D dönüş)</Button>
                </Grid>
                <CheckBox Content="Dönüş yönü başlangıç tahmini (çalışırken otomatik düzeltilir)" FontSize="9"
                          Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                          ToolTip="Sadece başlangıç tahmini; bot ilk dönüşte yanlış yöne döndüğünü fark edip kendi düzeltir"
                          IsChecked="{Binding NavTurnInvert}"/>

                <!-- Kamera px/derece (Farm scan overlay için) -->
                <TextBlock Text="Kamera duyarlılığı — Farm scan için (px/derece)" FontSize="9"
                           Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="2" Maximum="20" TickFrequency="0.5"
                          IsSnapToTickEnabled="True" VerticalAlignment="Center"
                          Value="{Binding NavCameraPixPerDeg}"/>
                  <TextBlock Grid.Column="2" Text="{Binding NavCameraPixPerDeg, StringFormat={}{0:0.0}}"
                             FontSize="10" FontFamily="{StaticResource FontMono}"
                             Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                  <Button Grid.Column="4" Style="{StaticResource BtnMuted}"
                          Command="{Binding CalibrateNavCameraCommand}"
                          Padding="5,2" FontSize="9">🔧 Kalibre</Button>
                </Grid>
                <CheckBox Content="Kamera yönü ters (CW/CCW flip)" FontSize="9"
                          Foreground="{StaticResource TextDim}" Margin="0,2,0,6"
                          IsChecked="{Binding NavCameraInvert}"/>

                <!-- Tolerans + Adım süresi -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Tolerans (koord birim)" FontSize="9"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding NavToleranceCoords, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Engel-aşma adımı (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding NavStepMs, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Takılınca recovery'de ne kadar ileri yürünsün (detour adımı)"/>
                  </StackPanel>
                </Grid>

                <!-- Waypoint'ler -->
                <TextBlock Text="WAYPOINT'LER" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="🛒 Merchant" FontSize="9"
                             VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Grid.Column="1" Text="{Binding NavMerchantWaypoint}" FontSize="9"
                             FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                             Foreground="{StaticResource Gold}"/>
                  <Button Grid.Column="3" Style="{StaticResource BtnMuted}"
                          Command="{Binding CaptureWaypointMerchantCommand}"
                          Padding="5,2" FontSize="9">📍 Şu an</Button>
                </Grid>

                <Grid Margin="0,0,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="🌀 Portal" FontSize="9"
                             VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Grid.Column="1" Text="{Binding NavPortalWaypoint}" FontSize="9"
                             FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                             Foreground="{StaticResource Gold}"/>
                  <Button Grid.Column="3" Style="{StaticResource BtnMuted}"
                          Command="{Binding CaptureWaypointPortalCommand}"
                          Padding="5,2" FontSize="9">📍 Şu an</Button>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="⚔ Farm" FontSize="9"
                             VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Grid.Column="1" Text="{Binding NavFarmSpotWaypoint}" FontSize="9"
                             FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                             Foreground="{StaticResource Gold}"/>
                  <Button Grid.Column="3" Style="{StaticResource BtnMuted}"
                          Command="{Binding CaptureWaypointFarmSpotCommand}"
                          Padding="5,2" FontSize="9">📍 Şu an</Button>
                </Grid>

                <!-- Test navigasyonu -->
                <Border Padding="8,6" CornerRadius="4" Background="{StaticResource BgInset}"
                        Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="TEST NAVİGASYON" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="X:" FontSize="10" VerticalAlignment="Center"
                                 Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
                      <TextBox Grid.Column="1" Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding NavTestX, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBlock Grid.Column="3" Text="Y:" FontSize="10" VerticalAlignment="Center"
                                 Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
                      <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding NavTestY, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource BtnMuted}" Command="{Binding TestNavigateCommand}"
                              Padding="7,3" FontSize="10" Margin="0,0,6,0">▶ Git</Button>
                      <Button Style="{StaticResource BtnMuted}" Command="{Binding StopNavTestCommand}"
                              Padding="7,3" FontSize="10">⏹ Dur</Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Durum -->
                <TextBlock Text="{Binding NavStatus}" FontSize="9"
                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ════════════ 6 · KASABA (SATIŞ / TAMİR / PORTAL) ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat6, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="🏙 Kasaba — Satış • Tamir • Portal"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Otonom modun town döngüsü: envanter dolunca Town'a ışınlan → merchant'a yürü → sat → (tamir) → portala yürü → farm noktasına dön. Her adımın butonlarını sırayla kalibre et."/>

            <!-- ── Merchant Satış (Faz 36) ─────────────────────────── -->
            <Expander Header="🛒 Merchant Satış" Foreground="{StaticResource TextMuted}"
                      FontSize="11" Margin="0,0,0,0">
              <Border Padding="10,8" Margin="0,6,0,0" CornerRadius="5"
                      Background="{StaticResource BgPanel2}"
                      BorderBrush="{StaticResource Border1}" BorderThickness="1">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                             Text="Akış: NPC sol-tık(seç)→sağ-tık(menü)→'I would like to trade.'→'Sell Item'→mod 'Confirm'→ikon-eşleşen yuvaları sağ-tık ile çantaya taşı→'Sell'→son 'Confirm'→kapat. Aşağıdaki noktaları sırayla (oyun açıkken merchant penceresi önünde) kalibre et, satılacak ikonu öğret, sonra 🛒 Test Sat."/>

                  <!-- ① NPC tıklama (sol-seç + sağ-menü otomatik) -->
                  <TextBlock Text="① NPC TIKLAMA (sol-seç + sağ-menü otomatik)" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Tık X ofseti (merkez px)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding MerchantClickOffsetX, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Tık Y ofseti (merkez px)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding MerchantClickOffsetY, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Menü bekleme (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding MerchantInteractDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <!-- ② "I would like to trade." -->
                  <TextBlock Text="② 'I would like to trade.' BUTONU" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding TradeDialogStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateTradeDialogCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Pencere bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding TradeDialogDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- ③ "Sell Item" sekmesi -->
                  <TextBlock Text="③ 'Sell Item' SEKMESİ" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding SellTabStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateSellTabCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Sekme bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding SellTabDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- ④ Mod değişimi "Confirm" -->
                  <TextBlock Text="④ MOD DEĞİŞİMİ 'Confirm'" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding SellModeConfirmStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateSellModeConfirmCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Onay bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding SellModeConfirmDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- ⑤ Merchant envanteri -->
                  <TextBlock Text="⑤ MERCHANT ENVANTER IZGARASI" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"
                             Text="Merchant penceresindeki alttaki çanta ızgarası — normal 'I' envanterinden farklı konumda olabilir."/>
                  <TextBlock Text="{Binding MerchantInvGridStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Button Style="{StaticResource BtnMuted}" Command="{Binding CalibrateMerchantInvGridCommand}"
                          Padding="5,3" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,8">🖊 Izgara Kalibre</Button>

                  <!-- ⑥ Satılacak ikon (template eşleştirme) -->
                  <Border Margin="0,0,0,8" Padding="8,6" CornerRadius="4" Background="{StaticResource BgInset}">
                    <StackPanel>
                      <TextBlock Text="⑥ SATILACAK İKON (template eşleştirme)" FontSize="9" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                      <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"
                                 Text="Satılacak eşya ikonunun çevresine kutu çiz → bot yalnız EŞLEŞEN yuvaları satar (iksir/parşömen tutulur). Birkaç farklı örnek öğretebilirsin."/>
                      <TextBlock Text="{Binding SellIconStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                                 Margin="0,0,0,4" TextWrapping="Wrap"/>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding TeachSellIconCommand}"
                                Padding="5,3" FontSize="10">🎓 İkon Öğret</Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnMuted}" Command="{Binding ResetSellIconsCommand}"
                                Padding="5,3" FontSize="10">🗑 Sıfırla</Button>
                        <Button Grid.Column="4" Style="{StaticResource BtnMuted}" Command="{Binding TestSellScanCommand}"
                                Padding="5,3" FontSize="10">🔎 Test Tara</Button>
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Eşleşme eşiği (0–1)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                          <TextBox Style="{StaticResource InputMono}" FontSize="10"
                                   Text="{Binding SellMatchThreshold, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="NCC eşiği; düşürürsen daha çok eşler (yanlış-pozitif riski), yükseltirsen daha katı"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Taşıma arası (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                          <TextBox Style="{StaticResource InputMono}" FontSize="10"
                                   Text="{Binding SellItemDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                          <CheckBox Content="Sağ-tık ile taşı" FontSize="9" Margin="0,0,0,4"
                                    Foreground="{StaticResource TextDim}"
                                    IsChecked="{Binding SellRightClick}"/>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- ⑦ "Sell" butonu -->
                  <TextBlock Text="⑦ 'Sell' BUTONU" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding SellButtonStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateSellButtonCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Onay bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding SellButtonDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- ⑧ Son "Confirm" (satış onayı) -->
                  <TextBlock Text="⑧ SON 'Confirm' (satış onayı)" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding SellConfirmButtonStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateSellConfirmButtonCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Onay bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding SellConfirmButtonDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- Kapat -->
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Kapat tuşu (boş=Escape)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding MerchantCloseKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Kapat sonrası bekleme (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding MerchantCloseDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Test -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}"
                            Command="{Binding TestMerchantTradeCommand}"
                            Padding="7,3" FontSize="10">🛒 Test Sat</Button>
                    <Button Grid.Column="2" Style="{StaticResource BtnMuted}"
                            Command="{Binding StopSellTestCommand}"
                            Padding="7,3" FontSize="10">⏹ Dur</Button>
                    <TextBlock Grid.Column="4" Text="{Binding SellStatus}" FontSize="10"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>

            <!-- ── Merchant Tamir (Faz 40) ──────────────────────────── -->
            <Expander Header="🔧 Merchant Tamir" Foreground="{StaticResource TextMuted}"
                      FontSize="11" Margin="0,8,0,0">
              <Border Padding="10,8" Margin="0,6,0,0" CornerRadius="5"
                      Background="{StaticResource BgPanel2}"
                      BorderBrush="{StaticResource Border1}" BorderThickness="1">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                             Text="Satıştan sonra AYNI merchant NPC'de tamir: NPC sol-seç→sağ-menü (satışla aynı ① ofset)→'I want to make repairs.'→envanter açılır (çekiç imleç)→seçili giyili ekipmanlara sırayla birer sol tık→kapat. 'Tamir etkin' kapalıysa adım atlanır."/>

                  <CheckBox Content="Tamir adımı etkin (Satış → Tamir → Portal)" FontSize="10" Margin="0,0,0,8"
                            Foreground="{StaticResource TextMuted}" IsChecked="{Binding RepairEnabled}"/>

                  <!-- ① "I want to make repairs." -->
                  <TextBlock Text="① 'I want to make repairs.' BUTONU" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding RepairDialogStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateRepairDialogCommand}"
                            Padding="5,3" FontSize="10">🖊 Kalibre</Button>
                    <TextBlock Grid.Column="2" Text="Envanter açılma bekleme (ms)" FontSize="9"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding RepairDialogDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <!-- ② Giyili ekipman ızgarası + slot seçici -->
                  <TextBlock Text="② GİYİLİ EKİPMAN IZGARASI (3×5) + SLOT SEÇİMİ" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"
                             Text="Envanteri aç (I) → 'Izgara Kalibre' ile 15 ekipman slotunun çevresine kutu çiz. Önizlemede onarılacak slotlara TIKLA (yeşil + sıra no). Tekrar tıkla = kaldır. Bot bu slotları SIRAYLA onarır."/>
                  <TextBlock Text="{Binding RepairEquipGridStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}" Command="{Binding CalibrateRepairEquipGridCommand}"
                            Padding="5,3" FontSize="10">🖊 Izgara Kalibre</Button>
                    <Button Grid.Column="2" Style="{StaticResource BtnMuted}" Command="{Binding RefreshRepairPreviewCommand}"
                            Padding="5,3" FontSize="10">🔄 Önizleme</Button>
                    <Button Grid.Column="4" Style="{StaticResource BtnMuted}" Command="{Binding ClearRepairSlotsCommand}"
                            Padding="5,3" FontSize="10">🗑 Seçimi Temizle</Button>
                  </Grid>
                  <TextBlock Text="{Binding RepairSlotsStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>

                  <!-- Slot seçici: ekipman önizleme görseli + 3×5 tıklanabilir overlay -->
                  <Border BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="4"
                          HorizontalAlignment="Left" Margin="0,0,0,8" Background="{StaticResource BgInset}">
                    <Grid Width="156" Height="260" Margin="3">
                      <Image Source="{Binding RepairEquipPreview}" Stretch="Fill" SnapsToDevicePixels="True"/>
                      <ItemsControl ItemsSource="{Binding RepairSlotCells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Rows="5" Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleRepairSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Index}" Cursor="Hand">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Grid Background="Transparent">
                                    <Border x:Name="hl" BorderThickness="2" CornerRadius="3" Margin="1"
                                            BorderBrush="Transparent" Background="Transparent"/>
                                    <TextBlock x:Name="ord" Text="{Binding Order}" FontSize="13" FontWeight="Bold"
                                               Foreground="#FF39FF14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="3" Visibility="Collapsed"/>
                                  </Grid>
                                  <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                      <Setter TargetName="hl"  Property="BorderBrush" Value="#FF39FF14"/>
                                      <Setter TargetName="hl"  Property="Background"  Value="#5539FF14"/>
                                      <Setter TargetName="ord" Property="Visibility"  Value="Visible"/>
                                    </DataTrigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>

                  <!-- ③ Tıklama arası gecikme -->
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Slot tıklama arası (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding RepairItemDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Test -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnMuted}"
                            Command="{Binding TestMerchantRepairCommand}"
                            Padding="7,3" FontSize="10">🔧 Test Tamir</Button>
                    <Button Grid.Column="2" Style="{StaticResource BtnMuted}"
                            Command="{Binding StopRepairTestCommand}"
                            Padding="7,3" FontSize="10">⏹ Dur</Button>
                    <TextBlock Grid.Column="4" Text="{Binding RepairStatus}" FontSize="10"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>

            <!-- ── Town TP + Portal (Faz 35) ────────────────────────── -->
            <Expander Header="🏙 Town TP + Portal" Foreground="{StaticResource TextMuted}"
                      FontSize="11" Margin="0,8,0,0">
              <Border Padding="10,8" Margin="0,6,0,0" CornerRadius="5"
                      Background="{StaticResource BgPanel2}"
                      BorderBrush="{StaticResource Border1}" BorderThickness="1">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                             Text="Tam döngü: Farm → Town TP → Merchant nav → Satış → Tamir → Portal nav → Portal giriş → Farm noktası → Farm. '🏙 Town TP Test' otonom modu başlatmadan yalnız ışınlanmayı dener; 'Şehre Git' ise tüm yolculuğu tetikler (çalışan otonom mod gerektirir)."/>

                  <!-- Town TP (UI butonu) -->
                  <TextBlock Text="TOWN IŞINLANMA (UI butonu)" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"
                             Text="Bu oyunda town'a dönüş sabit bir UI butonu (kısayol değil). Butonu kalibre et; alttaki TP tuşu yalnız buton kalibre EDİLMEZSE devreye girer."/>
                  <TextBlock Text="{Binding TownTpButtonStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding CalibrateTownTpButtonCommand}"
                            Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10"
                            VerticalAlignment="Bottom">🖊 Town Butonu Kalibre</Button>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Yükleme bekleme (ms)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding TownTpWaitMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Command="{Binding GoToTownNowCommand}"
                            Style="{StaticResource BtnMuted}" Padding="8,3" FontSize="10"
                            VerticalAlignment="Bottom" ToolTip="Otonom mod çalışırken town yolculuğunu manuel başlat (test için)">
                      🏙 Şehre Git
                    </Button>
                  </Grid>
                  <StackPanel Margin="0,0,0,4" HorizontalAlignment="Left" Width="150">
                    <TextBlock Text="TP Tuşu (fallback)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding TownTpKey, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>

                  <!-- Town TP testi (otonom modu başlatmadan) + durum -->
                  <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding TestTownTpCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10"
                            ToolTip="Otonom modu BAŞLATMADAN yalnız Town TP butonunu/tuşunu test eder">🏙 Town TP Test</Button>
                    <Button Grid.Column="2" Command="{Binding StopTownTestCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10">⏹ Dur</Button>
                    <TextBlock Grid.Column="4" Text="{Binding NavStatus}" FontSize="10"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>

                  <!-- Portal -->
                  <TextBlock Text="PORTAL ETKİLEŞİMİ" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,6,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"
                             Text="Portal waypoint'ine (📍 Koordinat &amp; Nav → 🌀 Portal) WorldNavigator ile gidilir. Ulaşınca portala NPC gibi tıklanır (sol-seç → sağ-menü); açılan menüde kalibre edilen 'manuel slot' öğesine tıklanır → anında ışınlanır. '🌀 Portal Test' otonom modu başlatmadan yalnız bu etkileşimi dener."/>

                  <!-- 'Manuel slot' menü öğesi (kalibre) -->
                  <TextBlock Text="{Binding PortalMenuSlotStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Button Command="{Binding CalibratePortalMenuSlotCommand}" HorizontalAlignment="Left"
                          Style="{StaticResource BtnMuted}" Padding="5,3" FontSize="10" Margin="0,0,0,6"
                          ToolTip="Portala tıkla, menü açılsın; sonra 'manuel slot' yazısına tek tıkla">🖊 'Manuel Slot' Kalibre</Button>

                  <TextBlock Text="PORTAL TIKLAMA KONUMU (ekran merkezinden offset)" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Tık X ofseti (ekran merkezi px)" FontSize="9"
                                 Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding PortalClickOffsetX, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Tık Y ofseti (↑ = negatif)" FontSize="9"
                                 Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding PortalClickOffsetY, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Portal testi (otonom modu başlatmadan) -->
                  <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding TestUsePortalCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10"
                            ToolTip="Otonom modu BAŞLATMADAN yalnız portal etkileşimini test eder (portala tıkla → menü → 'manuel slot')">🌀 Portal Test</Button>
                    <Button Grid.Column="2" Command="{Binding StopTownTestCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10">⏹ Dur</Button>
                    <TextBlock Grid.Column="4" Text="{Binding NavStatus}" FontSize="10"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>

                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Onay tuşu (fallback, boş=Enter)" FontSize="9"
                                 Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding PortalConfirmKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Menü bekleme (ms)" FontSize="9"
                                 Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding PortalInteractDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Portal yükleme (ms)" FontSize="9"
                                 Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding PortalWaitMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>

            <!-- ── NPC + Portal görsel tespiti (Faz 41) ─────────────── -->
            <Expander Header="🎯 NPC + Portal Tespiti (görsel)" Foreground="{StaticResource TextMuted}"
                      FontSize="11" Margin="0,8,0,0">
              <Border Padding="10,8" Margin="0,6,0,0" CornerRadius="5"
                      Background="{StaticResource BgPanel2}"
                      BorderBrush="{StaticResource Border1}" BorderThickness="1">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                             Text="Mob YOLO'sundan AYRI, 2 sınıflı (npc, portal) küçük model. Navigasyon merchant/portal'a varınca ekranı tarayıp kutu-MERKEZİNE tıklar — kör tık yerine. Kamera açısı NPC/portal'ı merkezden kaydırsa bile ıskalamaz; menü açılışı + portal ışınlanması doğrulanır, olmazsa town turu tekrar denenir. Model YOKSA eski kör-tık fallback'i çalışır. Eğitim: tools/yolo_trainer (sınıf 0=npc, 1=portal)."/>

                  <TextBlock Text="MODEL (.onnx — 2 sınıf: npc, portal)" FontSize="9" FontWeight="SemiBold"
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBox Style="{StaticResource InputMono}" FontSize="10" Margin="0,0,0,4"
                           Text="{Binding NpcPortalModelPath, UpdateSourceTrigger=PropertyChanged}"/>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding BrowseNpcPortalModelCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10">📂 Seç</Button>
                    <Button Grid.Column="2" Command="{Binding AutoDiscoverNpcPortalModelCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10">🔍 Otomatik Bul</Button>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Güven eşiği (0-1)" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                      <TextBox Style="{StaticResource InputMono}" FontSize="10"
                               Text="{Binding NpcPortalConfThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding NpcPortalStatus}" FontSize="10" Foreground="{StaticResource Gold}"
                             Margin="0,0,0,8" TextWrapping="Wrap"/>

                  <!-- Canlı tespit testi (otonom modu başlatmadan) -->
                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding TestNpcPortalDetectCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10"
                            ToolTip="Oyunda canlı NPC + portal tespiti — bulunan kutu/güven skorunu raporlar (modele güvenmeden önce)">🎯 Tespit Test</Button>
                    <Button Grid.Column="2" Command="{Binding StopNpcPortalTestCommand}" Style="{StaticResource BtnMuted}"
                            Padding="7,3" FontSize="10">⏹ Dur</Button>
                    <TextBlock Grid.Column="4" Text="{Binding NpcPortalTestStatus}" FontSize="10"
                               FontFamily="{StaticResource FontMono}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>

          <!-- ════════════ 7 · GENEL ════════════ -->
          <StackPanel Visibility="{Binding IsChecked, ElementName=Cat7, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource CatSection}" Text="⚙ Genel — Dayanıklılık &amp; Kısayollar"/>
            <Border Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                           Text="Global hotkey ile otonom modu açıp kapat. Art arda hata eşiğini aşınca mod durur; her başarılı durum geçişinde sayaç sıfırlanır. Hata sonrası akıllı kurtarma: town zincirindeyse TP'den yeniden, farm'daysa aynı noktada devam eder."/>

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Genel Hotkey (varsayılan F10)" FontSize="9"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding AutonomousHotKey, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Otonom modu açıp kapayan global kısayol tuşu"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Max art arda hata (sonra dur)" FontSize="9"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource InputMono}" FontSize="10"
                             Text="{Binding MaxConsecutiveFailures, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Bu kadar art arda hata olursa otonom mod durur"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
