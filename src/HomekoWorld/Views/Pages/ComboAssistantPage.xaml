<UserControl x:Class="HomekoWorld.Views.Pages.ComboAssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:HomekoWorld.Views.Controls">

  <!-- 2-column: class mini-sidebar | workspace -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="110"/>  <!-- class mini-sidebar -->
      <ColumnDefinition Width="*"/>    <!-- workspace -->
    </Grid.ColumnDefinitions>

    <!-- ── Class mini-sidebar ─────────────────────────────────────────── -->
    <Border Grid.Column="0"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Border1}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="0,12,0,0">

        <TextBlock Text="SINIF" Margin="10,0,0,8"
                   FontFamily="{StaticResource FontDisplay}"
                   FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}"/>

        <ItemsControl ItemsSource="{Binding Classes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="6,1" CornerRadius="5" Cursor="Hand" Padding="6,6">
                <Border.InputBindings>
                  <MouseBinding MouseAction="LeftClick"
                                Command="{Binding DataContext.SelectClassCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}"/>
                </Border.InputBindings>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background"      Value="{StaticResource BgPanel2}"/>
                    <Setter Property="BorderBrush"     Value="{StaticResource Border1}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background"  Value="#1AD4A44A"/>
                        <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                      </DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource TextSoft}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <!-- Icon badge -->
                  <Border Width="26" Height="26" CornerRadius="4" Margin="0,0,0,4"
                          HorizontalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background"  Value="{StaticResource BgInset}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border1}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderGold}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding IconKey}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <!-- Name -->
                  <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center"
                             TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>

    <!-- ── Workspace (combo list + editor) ────────────────────────────── -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- Tabs + search -->
        <RowDefinition Height="*"/>     <!-- Content -->
      </Grid.RowDefinitions>

      <!-- Tab row -->
      <Border Grid.Row="0" Height="40"
              Background="{StaticResource BgPanel}"
              BorderBrush="{StaticResource Divider}"
              BorderThickness="0,0,0,1">
        <Grid Margin="12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Tabs + Profile filter -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Padding="10,4" Margin="0,0,4,0" CornerRadius="3"
                    Background="{StaticResource BgPanel2}"
                    BorderBrush="{StaticResource BorderGold}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kombolar" FontSize="12" Foreground="{StaticResource Gold}" FontWeight="Medium"/>
                <Border Style="{StaticResource KeyChip}" Margin="6,0,0,0">
                  <TextBlock Text="{Binding Filtered.Count}" FontSize="10" FontFamily="{StaticResource FontMono}"
                             Foreground="{StaticResource TextMuted}"/>
                </Border>
              </StackPanel>
            </Border>

            <Rectangle Width="1" Height="18" Fill="{StaticResource Border1}" Margin="6,0"/>

            <!-- Profile tabs -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

              <Button Command="{Binding SelectProfileCommand}" CommandParameter="all"
                      Padding="8,3" Margin="0,0,3,0" FontSize="11">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                    <Setter Property="Content"    Value="Tümü"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CurrentProfile}" Value="all">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                        <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>

              <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Name}"
                            Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Id}"
                            Padding="8,3" Margin="0,0,3,0" FontSize="11">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                          <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                              <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- + Profil button -->
              <Button Command="{Binding StartAddProfileCommand}"
                      Padding="6,3" Margin="0,0,3,0" FontSize="11"
                      ToolTip="Yeni profil oluştur">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAddingProfile}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <TextBlock Text="+ Profil"/>
              </Button>

              <!-- Inline new profile input -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAddingProfile}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBase}"
                         Width="90" VerticalAlignment="Center" Tag="Profil adı"/>
                <Button Command="{Binding ConfirmNewProfileCommand}"
                        Padding="7,3" Margin="3,0,0,0" FontSize="12" ToolTip="Kaydet">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                    </Style>
                  </Button.Style>
                  <TextBlock Text="✓"/>
                </Button>
                <Button Command="{Binding CancelNewProfileCommand}"
                        Padding="7,3" Margin="2,0,0,0" FontSize="12" ToolTip="İptal">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                    </Style>
                  </Button.Style>
                  <TextBlock Text="✕"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Search box -->
          <Border Grid.Column="2" Style="{StaticResource PanelInset}" VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Path Grid.Column="0"
                    Data="M 12 5 A 7 7 0 1 0 12 19 A 7 7 0 1 0 12 5 M 16.95 16.95 L 21 21"
                    Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="Uniform" Margin="6,0,4,0" Width="13" Height="13"/>
              <TextBox Grid.Column="1" Style="{StaticResource InputSearch}"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Tag="Ara…"/>
            </Grid>
          </Border>

          <!-- Yeni Kombo -->
          <Button Grid.Column="4" Style="{StaticResource BtnPrimary}"
                  Command="{Binding NewComboCommand}"
                  Padding="10,5" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontSize="14" Margin="0,-1,3,0"/>
              <TextBlock Text="Yeni Kombo"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Workspace body -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14,12,14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Combo editor (inline) -->
          <ctrl:ComboEditor Grid.Row="0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

          <!-- Combo list -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Filtered}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,4" CornerRadius="5" Cursor="Hand"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFiring}" Value="True">
                          <Setter Property="Background"  Value="#1A8B6914"/>
                          <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{StaticResource BgHover}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>

                  <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name + desc + steps -->
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Text}"/>
                        <Border Style="{StaticResource KeyChip}" Margin="8,0,0,0"
                                Visibility="{Binding IsBound, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{Binding BindingLabel}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="10" Foreground="{StaticResource Gold}"/>
                        </Border>
                        <Border Style="{StaticResource KeyChip}" Margin="4,0,0,0"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="Custom" FontSize="9" Foreground="{StaticResource Blue}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" Margin="6,0,0,0">
                          <Run Text="{Binding StepCount, Mode=OneWay}"/>
                          <Run Text=" adım"/>
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>

                    <!-- Duplicate -->
                    <Button Grid.Column="1" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.DuplicateComboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="Kopyala" Margin="4,0,0,0">
                      <Path Data="M8 4H4v16h12v-4M12 4h8v12h-8V4z"
                            Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>
                    </Button>

                    <!-- Edit -->
                    <Button Grid.Column="2" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.EditComboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Düzenle" Margin="4,0,0,0">
                      <Path Data="M4 20h4l10-10-4-4L4 16v4Zm14-14-2-2 2 2Z"
                            Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>
                    </Button>

                    <!-- Delete -->
                    <Button Grid.Column="3" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.DeleteComboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="Sil" Margin="4,0,0,0">
                      <Path Data="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"
                            Stroke="{StaticResource Red}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </Grid>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
