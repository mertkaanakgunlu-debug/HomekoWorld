<Window x:Class="HomekoWorld.Views.LogHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="300" Height="260" MinWidth="180" MinHeight="120"
        Title="Log HUD">

  <Border CornerRadius="6" Margin="4" Background="#C0130E09"
          BorderBrush="#44D4A44A" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.7" ShadowDepth="2"/>
    </Border.Effect>

    <DockPanel>
      <!-- Başlık çubuğu (sürükleme) -->
      <Grid x:Name="DragHandle" DockPanel.Dock="Top" Background="#22D4A44A" Cursor="SizeAll">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="📋 Canlı Log" FontSize="10" FontWeight="SemiBold"
                   Foreground="#FFD4A44A" Margin="8,4" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Click="CloseButton_Click" Content="✕"
                Background="Transparent" BorderThickness="0" Foreground="#99E8DCC0"
                Cursor="Hand" Padding="8,2" FontSize="11"/>
      </Grid>

      <!-- Aktivite listesi -->
      <ListBox x:Name="LogList" ItemsSource="{Binding FarmActivityLog}"
               Background="Transparent" BorderThickness="0" Padding="0,2"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               FontFamily="{StaticResource FontMono}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="6,1">
              <TextBlock Text="{Binding Time}" FontSize="9" Foreground="#66E8DCC0"
                         Margin="0,0,6,0" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding Text}" FontSize="10" TextWrapping="Wrap" MaxWidth="220">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#99E8DCC0"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="key">
                        <Setter Property="Foreground" Value="#FF7FB0E0"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="combo">
                        <Setter Property="Foreground" Value="#FFD4A44A"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="guard">
                        <Setter Property="Foreground" Value="#FFE05555"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
