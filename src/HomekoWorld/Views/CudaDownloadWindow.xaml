<Window x:Class="HomekoWorld.Views.CudaDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDIA CUDA Kütüphaneleri Eksik" Height="300" Width="550" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Text}">
    
    <Border Background="{StaticResource BgMain}" 
            BorderBrush="{StaticResource BorderGold}" 
            BorderThickness="2" 
            CornerRadius="10" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" Direction="270" ShadowDepth="5"/>
        </Border.Effect>
        
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <TextBlock Text="NVIDIA CUDA Hızlandırma Paketi" 
                       Foreground="{StaticResource TextGold}" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Sisteminizdeki NVIDIA ekran kartından maksimum verim (Tensor Çekirdekleri) alabilmek için gerekli kütüphaneler (CUDA/cuDNN) otomatik olarak indiriliyor."
                       Foreground="{StaticResource TextSoft}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="13"
                       Margin="0,0,0,25"
                       Grid.Row="1"/>
            
            <!-- Durum Metni -->
            <TextBlock x:Name="StatusText" 
                       Text="Sunucuya bağlanılıyor..." 
                       TextWrapping="Wrap" 
                       Grid.Row="2" 
                       Foreground="{StaticResource Text}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom" 
                       FontSize="14"
                       Margin="0,0,0,15"/>
            
            <!-- İlerleme Çubuğu -->
            <ProgressBar x:Name="DownloadProgress" 
                         Height="12" 
                         Grid.Row="3" 
                         Minimum="0" Maximum="100" 
                         BorderThickness="0"
                         Background="{StaticResource BgPanel}"
                         Foreground="{StaticResource TextGold}">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
