<Window x:Class="HomekoWorld.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Width="460" Height="420"
        MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        BorderBrush="{StaticResource Border1}"
        BorderThickness="1">

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="16,12"
            Background="#FF0F0C08"
            BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
      <TextBlock Text="Ayarlar"
                 FontFamily="{StaticResource FontDisplay}"
                 FontSize="16" Foreground="{StaticResource Gold}"/>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,14,16,14">

        <!-- Global başlat tuşu -->
        <Border Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="GLOBAL BAŞLAT TUŞU" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Uygulamayı etkinleştirmek / pasifleştirmek için kullanılacak tuş. Varsayılan: F12"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Aktif / Pasif tuşu" FontSize="11"
                         Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="2" Style="{StaticResource InputMono}" FontSize="12"
                       Text="{Binding GlobalStartKey, UpdateSourceTrigger=LostFocus}"
                       ToolTip="Örn: F12, F11, Insert"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Telefon bağlantı varsayılanları -->
        <Border Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="TELEFON BAĞLANTI VARSAYILANLARI" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

            <TextBlock Text="WiFi / USB IP" FontSize="10"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
            <TextBox Style="{StaticResource InputBase}" FontSize="11" Margin="0,0,0,6"
                     Text="{Binding PhoneHost, UpdateSourceTrigger=LostFocus}"
                     ToolTip="HomekoBridge'in çalıştığı telefon IP adresi"/>

            <TextBlock Text="Port" FontSize="10"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
            <TextBox Style="{StaticResource InputMono}" FontSize="11" Width="100" HorizontalAlignment="Left"
                     Text="{Binding PhonePort, UpdateSourceTrigger=LostFocus}"
                     ToolTip="TCP port (varsayılan: 5556)"/>
          </StackPanel>
        </Border>

        <!-- Test hotkey'leri -->
        <Border Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="TEST KISA YOLLARI" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Oyun önde iken bu tuşlara basarak testleri tetikleyebilirsin."/>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Klavye Kombo Testi tuşu" FontSize="11"
                         Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="2" Style="{StaticResource InputMono}" FontSize="11"
                       Text="{Binding KeyboardTestKey, UpdateSourceTrigger=LostFocus}"
                       ToolTip="Kombonun klavye girdisini arka planda test eder"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Performans & ML Ayarları -->
        <Border Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="PERFORMANS &amp; ML AYARLARI" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

            <CheckBox IsChecked="{Binding FarmRecordingMode}"
                      Foreground="{StaticResource TextMuted}" FontSize="11"
                      Margin="0,0,0,6"
                      Content="🎥 Kayıt/Performans modu (OBS ile)"
                      ToolTip="OBS ile ekran kaydı alırken aç: YOLO tespit hızını ~15 FPS'e düşürür → GPU'ya nefes verir, imleç takılmasını/çakışmayı azaltır. Kapalıyken tam hız."/>

            <CheckBox IsChecked="{Binding FarmDxgiCapture}"
                      Foreground="{StaticResource TextMuted}" FontSize="11"
                      Margin="0,0,0,6"
                      Content="⚡ DXGI hızlı yakalama (kapalı = GDI)"
                      ToolTip="Açık (önerilen): ekran yakalama GPU üzerinden (~1-2ms) → daha akıcı tespit, daha az takılma. Kapalı: eski GDI yöntemi (~15-30ms). DXGI sorun çıkarırsa (siyah kare/uyumsuzluk) kapat. Değişiklik farm'ı durdurup tekrar başlatınca geçerli olur."/>

            <!-- T4: ONNX execution provider -->
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="⚙ İşlemci (EP)" FontSize="11" VerticalAlignment="Center"
                         Foreground="{StaticResource TextMuted}"/>
              <ComboBox Grid.Column="2" Style="{StaticResource ComboBase}" FontSize="11"
                        ItemsSource="{Binding InferenceBackendOptions}"
                        SelectedItem="{Binding FarmInferenceBackend}"
                        ToolTip="Auto (önerilen): donanım GPU varsa DirectML, yoksa CPU. DirectML: zorla GPU (her DX12 GPU). Cpu: zorla CPU. Değişiklik yüklü modeli yeniden kurar."/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Test Click -->
        <Border Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="TEST TIKLAMASI" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Oyun önde iken bir koordinatı kaydedip test tıklaması gönderebilirsiniz."/>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="48"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Command="{Binding CalibrateTestClickCommand}"
                      Style="{StaticResource BtnMuted}"
                      Padding="5,4" FontSize="11"
                      ToolTip="Ekranda bir noktaya tıkla — bot o koordinatı kaydeder">
                <TextBlock Text="📍 Nokta Seç"/>
              </Button>
              <Button Grid.Column="2" Command="{Binding RunTestClickCommand}"
                      Style="{StaticResource BtnGhost}"
                      Padding="8,4" FontSize="11"
                      ToolTip="Kaydedilen noktaya bot tıklaması gönder">
                <TextBlock Text="▶ Test Et"/>
              </Button>
              <TextBox Grid.Column="4"
                       Style="{StaticResource InputMono}" FontSize="11"
                       Text="{Binding FarmTestClickKey, UpdateSourceTrigger=LostFocus}"
                       ToolTip="Bu tuşa basınca test tıklaması tetiklenir (örn: F8)"/>
            </Grid>
            <TextBlock Text="{Binding TestClickStatus}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Gold}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TestClickStatus}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
