<Window x:Class="HomekoWorld.Views.Controls.SkillPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill Seç"
        Width="620" Height="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

  <Border Background="{StaticResource BgPanel}"
          BorderBrush="{StaticResource BorderGold}"
          BorderThickness="1"
          CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="50"/>
      </Grid.RowDefinitions>

      <!-- Title bar (draggable) -->
      <Border Grid.Row="0"
              Background="{StaticResource BgVoid}"
              CornerRadius="4,4,0,0"
              MouseLeftButtonDown="TitleBar_MouseDown"
              Padding="14,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="✦" Foreground="{StaticResource Gold}"
                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Skill Seç"
                       FontFamily="{StaticResource FontDisplay}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Gold}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <Button Style="{StaticResource BtnWin}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Click="Cancel_Click">✕</Button>
        </Grid>
      </Border>

      <!-- Search row -->
      <Border Grid.Row="1"
              Background="{StaticResource BgBase}"
              BorderBrush="{StaticResource Border1}"
              BorderThickness="0,0,0,1"
              Padding="10,6,10,6">
        <Grid>
          <TextBox x:Name="SearchBox"
                   Style="{StaticResource InputMono}"
                   Padding="6,5"
                   FontSize="12"
                   TextChanged="SearchBox_TextChanged"/>
          <TextBlock Text="Skill ara…"
                     IsHitTestVisible="False"
                     Foreground="{StaticResource TextDim}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Margin="9,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <!-- Tab strip — tabs generated in code-behind (visible when search empty) -->
      <TabControl x:Name="BarTabs" Grid.Row="2"
                  Background="Transparent"
                  BorderThickness="0"
                  SelectionChanged="BarTabs_SelectionChanged">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{StaticResource Border1}"
                          BorderThickness="0,0,0,2"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
        </TabControl.Resources>
      </TabControl>

      <!-- Search results panel (shown when query is active) -->
      <ScrollViewer x:Name="SearchPanel" Grid.Row="2"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="SearchResults" Margin="8"/>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="3"
              Background="{StaticResource BgVoid}"
              BorderBrush="{StaticResource Border1}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,4,4"
              Padding="14,0">
        <Button Style="{StaticResource BtnGhost}"
                Click="Cancel_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Padding="16,6">İptal</Button>
      </Border>

    </Grid>
  </Border>
</Window>
