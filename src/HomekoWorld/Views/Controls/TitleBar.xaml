<UserControl x:Class="HomekoWorld.Views.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border Height="34"
          Background="#FF1A140D"
          BorderBrush="#FF000000"
          BorderThickness="0,0,0,1">
    <Border.Effect>
      <DropShadowEffect Color="#FFD4A44A" BlurRadius="0" ShadowDepth="1" Opacity="0.08" Direction="270"/>
    </Border.Effect>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>   <!-- 0: Brand -->
        <ColumnDefinition Width="Auto"/>   <!-- 1: Title -->
        <ColumnDefinition Width="*"/>      <!-- 2: Drag -->
        <ColumnDefinition Width="Auto"/>   <!-- 3: Settings -->
        <ColumnDefinition Width="Auto"/>   <!-- 4: Help -->
        <ColumnDefinition Width="Auto"/>   <!-- 5: Min -->
        <ColumnDefinition Width="Auto"/>   <!-- 6: Max -->
        <ColumnDefinition Width="Auto"/>   <!-- 7: Close -->
      </Grid.ColumnDefinitions>

      <!-- Brand mark -->
      <Viewbox Grid.Column="0" Width="20" Height="20" Margin="10,0,6,0" VerticalAlignment="Center">
        <Canvas Width="96" Height="96">
          <!-- Outer lozenge -->
          <Path Data="M48 4 L92 48 L48 92 L4 48 Z" Fill="Transparent" StrokeThickness="2.4">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f5d27c" Offset="0"/>
                <GradientStop Color="#8b6914" Offset="1"/>
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
          <!-- Inner lozenge -->
          <Path Data="M48 10 L86 48 L48 86 L10 48 Z" Fill="Transparent"
                Stroke="#8b6914" StrokeThickness="0.7" Opacity="0.6"/>
          <!-- Separator lines -->
          <Line X1="20" Y1="62" X2="76" Y2="62" Stroke="#d4a44a" StrokeThickness="0.8" Opacity="0.7"/>
          <Line X1="22" Y1="64" X2="74" Y2="64" Stroke="#8b6914" StrokeThickness="0.5" Opacity="0.5"/>
          <!-- Chevron 1 -->
          <Path Data="M48 20.2 L31 33.8 h6.8 L48 25.3 L58.2 33.8 h6.8 Z" Opacity="0.4">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f5d27c" Offset="0"/>
                <GradientStop Color="#d4a44a" Offset="1"/>
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <!-- Chevron 2 -->
          <Path Data="M48 33.2 L31 46.8 h6.8 L48 38.3 L58.2 46.8 h6.8 Z" Opacity="0.7">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f5d27c" Offset="0"/>
                <GradientStop Color="#d4a44a" Offset="1"/>
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <!-- Chevron 3 -->
          <Path Data="M48 46.2 L31 59.8 h6.8 L48 51.3 L58.2 59.8 h6.8 Z" Opacity="1">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f5d27c" Offset="0"/>
                <GradientStop Color="#d4a44a" Offset="1"/>
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <!-- Three dots -->
          <Rectangle Canvas.Left="40" Canvas.Top="70" Width="3" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#f5d27c"/>
          <Rectangle Canvas.Left="46" Canvas.Top="70" Width="3" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#f5d27c"/>
          <Rectangle Canvas.Left="52" Canvas.Top="70" Width="3" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#f5d27c"/>
        </Canvas>
      </Viewbox>

      <!-- Title -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="FujiMacro"
                   FontFamily="{StaticResource FontDisplay}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Gold}"/>
        <TextBlock Text=" · 1.0.0"
                   FontSize="11"
                   Foreground="{StaticResource TextMuted}"
                   Margin="2,0,0,0"/>
      </StackPanel>

      <!-- Drag region -->
      <Border Grid.Column="2" Background="Transparent"
              x:Name="DragArea" MouseLeftButtonDown="DragArea_MouseLeftButtonDown"/>

      <!-- Settings button -->
      <Button Grid.Column="3" Style="{StaticResource BtnWin}"
              Command="{Binding DataContext.OpenSettingsCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="Ayarlar" Margin="0,0,2,0">
        <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>

      <!-- Help button -->
      <Button Grid.Column="4" Style="{StaticResource BtnWin}"
              Command="{Binding DataContext.OpenHelpCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="Yardım" Margin="0,0,4,0">
        <TextBlock Text="❓" FontSize="11" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>

      <!-- Window buttons -->
      <Button Grid.Column="5" Style="{StaticResource BtnWin}"
              x:Name="BtnMin" Click="BtnMin_Click"
              ToolTip="Küçült">
        <Path Data="M4 12 H20" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>

      <Button Grid.Column="6" Style="{StaticResource BtnWin}"
              x:Name="BtnMax" Click="BtnMax_Click"
              ToolTip="Büyüt">
        <Rectangle Width="9" Height="9" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"/>
      </Button>

      <Button Grid.Column="7" Style="{StaticResource BtnWinClose}"
              x:Name="BtnClose" Click="BtnClose_Click"
              ToolTip="Kapat">
        <Path Data="M5 5 L19 19 M19 5 L5 19"
              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
