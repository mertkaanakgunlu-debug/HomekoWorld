<UserControl x:Class="HomekoWorld.Views.Controls.ComboEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HomekoWorld.ViewModels">

  <Border Style="{StaticResource PanelGold}" Margin="0,0,0,10" Padding="14">
    <StackPanel DataContext="{Binding Editor}">

      <!-- Header -->
      <Grid Margin="0,0,0,10">
        <TextBlock FontFamily="{StaticResource FontDisplay}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Gold}"
                   VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Kombo Düzenle"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                  <Setter Property="Text" Value="Yeni Kombo"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Loop toggle — sağ üst köşe -->
        <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="{Binding IsLoop}"
                      Padding="8,4" FontSize="11"
                      Cursor="Hand"
                      ToolTip="Aktifken kombo tetiklenince sürekli tekrarlar. Durdurmak için aynı tuşa tekrar bas veya ■ butonuna bas.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton">
              <Setter Property="Background"   Value="Transparent"/>
              <Setter Property="BorderBrush"  Value="{StaticResource Border2}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground"   Value="{StaticResource TextMuted}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Background"  Value="#1A8B6914"/>
                  <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                  <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource TextSoft}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⟳" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="Loop" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
      </Grid>

      <!-- Name -->
      <TextBlock Text="İsim" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
      <TextBox Style="{StaticResource InputBase}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,8"/>

      <!-- Description -->
      <TextBlock Text="Açıklama" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
      <TextBox Style="{StaticResource InputBase}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,10"/>

      <!-- Profile -->
      <TextBlock Text="Profil" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <StackPanel.Resources>
          <Style x:Key="ProfBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding"    Value="8,3"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
          </Style>
        </StackPanel.Resources>

        <!-- Tümü — assigns combo to all profiles (global) -->
        <Button Content="Tümü"
                Command="{Binding SelectProfileCommand}" CommandParameter="all">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ProfBtn}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProfileId}" Value="all">
                  <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                  <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <!-- Dynamic profile buttons from AvailableProfiles -->
        <ItemsControl ItemsSource="{Binding AvailableProfiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}"
                      Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding Id}"
                      Padding="8,3" Margin="0,0,4,0" FontSize="11">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                        <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Class -->
      <TextBlock Text="Sınıf" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal">
          <StackPanel.Resources>
            <Style x:Key="ClassBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
              <Setter Property="Padding"  Value="7,3"/>
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Margin"   Value="0,0,4,0"/>
              <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Style>
          </StackPanel.Resources>

          <!-- Tümü — combo appears in every class view -->
          <Button Content="Tümü"
                  Command="{Binding SelectClassCommand}" CommandParameter="all">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ClassBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ClassId}" Value="all">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                    <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>

          <!-- Dynamic class buttons -->
          <ItemsControl ItemsSource="{Binding AvailableClasses}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}"
                        Command="{Binding DataContext.SelectClassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Id}"
                        Padding="7,3" Margin="0,0,4,0" FontSize="11">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                          <Setter Property="Foreground"  Value="{StaticResource Gold}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Key binding -->
      <TextBlock Text="Tetikleyici Tuş" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
      <Border x:Name="BindingCapture" Margin="0,0,0,10"
              Style="{StaticResource PanelInset}"
              Cursor="Hand" MouseLeftButtonDown="BindingCapture_Click"
              Padding="8,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource Gold}"
                     Text="{Binding BindingDisplay}" VerticalAlignment="Center"/>
          <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="(tuşa bas)"/>
                <Setter Property="Foreground" Value="Transparent"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Text" Value="← tuşa bas..."/>
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Steps header + add buttons -->
      <TextBlock Text="ADIMLAR" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/>
      <WrapPanel Margin="0,0,0,6" Orientation="Horizontal">
        <WrapPanel.Resources>
          <Style x:Key="StepAddBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding"  Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin"   Value="0,0,4,4"/>
          </Style>
        </WrapPanel.Resources>

        <!-- Skill Ekle -->
        <Button Style="{StaticResource StepAddBtn}" Command="{Binding AddSkillStepCommand}"
                ToolTip="Kalibre edilmiş skill bar'dan bir skill adımı ekler. Önce 'Skill Barı Konfigüre Et'.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✦" Foreground="{StaticResource Gold}" Margin="0,0,4,0"/>
            <TextBlock Text="Skill Ekle" Foreground="{StaticResource Gold}"/>
          </StackPanel>
        </Button>

        <!-- Hareket Ekle -->
        <Button Style="{StaticResource StepAddBtn}" Command="{Binding AddMovementStepCommand}"
                ToolTip="W/A/S/D hareket adımı ekler (kısa dokunuş — animasyon ivmesi için).">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="→" Foreground="#FF5599FF" Margin="0,0,4,0"/>
            <TextBlock Text="Hareket Ekle" Foreground="#FF5599FF"/>
          </StackPanel>
        </Button>

        <!-- Tuş Ekle -->
        <Button Style="{StaticResource StepAddBtn}" Command="{Binding AddTapStepCommand}"
                ToolTip="Ham tuş adımı ekler (herhangi bir tuş, sayı, F tuşu vb.).">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="+" FontSize="14" Margin="0,-1,3,0" Foreground="{StaticResource Gold}"/>
            <TextBlock Text="Tuş Ekle"/>
          </StackPanel>
        </Button>

        <!-- İptal Ekle -->
        <Button Style="{StaticResource StepAddBtn}" Command="{Binding AddCancelStepCommand}"
                ToolTip="Animasyon iptali adımı ekler (W, 20ms dokunuş). Skill toparlanma animasyonunu keser.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✕" Foreground="#FFFF8844" Margin="0,0,4,0"/>
            <TextBlock Text="İptal Ekle"/>
          </StackPanel>
        </Button>

      </WrapPanel>

      <Border Style="{StaticResource PanelInset}" Padding="4" Margin="0,0,0,10">
        <StackPanel>
          <!-- Sütun başlıkları -->
          <Grid Margin="2,2,2,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="58"/>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tuş" FontSize="10"
                       Foreground="{StaticResource TextMuted}" Margin="4,0"/>
            <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource TextMuted}"
                       Text="Tutuş (ms)"
                       ToolTip="KEYDOWN ile KEYUP arasındaki süre (ms) — tuşun basılı tutulma süresi.&#x0a;Skill: 15-30ms önerilir. İptal/Hareket: 10-20ms. Daha uzun = daha güvenli ama daha yavaş."/>
            <TextBlock Grid.Column="2" FontSize="10" Foreground="{StaticResource TextMuted}"
                       Text="Sonrası (ms)"
                       ToolTip="Tuş çekildikten sonra, bir sonraki adımdan önce bekleme süresi.&#x0a;Son adımda 0 yazabilirsin."/>
            <TextBlock Grid.Column="3" FontSize="9" Foreground="{StaticResource TextMuted}"
                       Text="Adapt" TextAlignment="Center"
                       ToolTip="İşaretliyse bu adımın 'Sonrası (ms)' değeri&#x0a;ping ve FPS ayarlarına göre otomatik ölçeklenir.&#x0a;(Faz 14 ping + Faz 15 FPS — sağ panelden ayarla)"/>
          </Grid>
          <!-- Kaydırılabilir adım listesi -->
          <ScrollViewer MaxHeight="252" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="StepsScroll_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,2" MinHeight="32">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="Cancel">
                            <Setter Property="Background" Value="#18FF6600"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Movement">
                            <Setter Property="Background" Value="#183399FF"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Skill">
                            <Setter Property="Background" Value="#188B6914"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="58"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition Width="26"/>
                      <ColumnDefinition Width="26"/>
                      <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>

                    <!-- Key input (Tap / Cancel / Movement) -->
                    <TextBox Grid.Column="0"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" VerticalAlignment="Center"
                             ToolTip="Tuş adı: 1-9, F1-F12, W, A, S, D, Space, vb.">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Skill">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>

                    <!-- Skill placeholder (Faz 12'de ikon/isim ile değişecek) -->
                    <Border Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource GoldDeep}" BorderThickness="1"
                            CornerRadius="3" Padding="6,3">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Skill">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11" Foreground="{StaticResource Gold}"
                                 Text="{Binding SkillId, TargetNullValue='(skill seç — Skill Barı Konfigüre Et)'}"/>
                    </Border>

                    <!-- Hold duration: time between KEYDOWN and KEYUP sent to Android -->
                    <Grid Grid.Column="1" Margin="0,0,4,0">
                      <TextBox Style="{StaticResource InputMono}"
                               Text="{Binding HoldMs, UpdateSourceTrigger=PropertyChanged}"
                               Padding="5,5,22,5"
                               VerticalAlignment="Center"
                               ToolTip="Tuş basılı tutulma süresi (ms). Min 10ms."/>
                      <TextBlock Text="ms" FontSize="10" Foreground="{StaticResource TextMuted}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                 IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Post-step delay -->
                    <Grid Grid.Column="2" Margin="0,0,4,0">
                      <TextBox Style="{StaticResource InputMono}"
                               Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                               Padding="5,5,22,5"
                               VerticalAlignment="Center"
                               ToolTip="Tuş çekildikten sonra bekleme süresi (ms). 0 = hemen sonraki adım."/>
                      <TextBlock Text="ms" FontSize="10" Foreground="{StaticResource TextMuted}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                 IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Adaptive delay toggle (Faz 14/15) -->
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding IsAdaptive}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Bu adımın bekleme süresi ping ve FPS'e göre ölçeklensin mi?&#x0a;Sağ paneldeki 'ADAPTİF GECİKME' ayarlarıyla kontrol edilir."/>

                    <!-- Move up/down/delete -->
                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Yukarı">
                      <Path Data="M12 15 L12 9 M9 12 L12 9 L15 12"
                            Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>

                    <Button Grid.Column="5" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Aşağı">
                      <Path Data="M12 9 L12 15 M9 12 L12 15 L15 12"
                            Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource BtnIcon}"
                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Sil">
                      <Path Data="M6 6 L18 18 M18 6 L6 18"
                            Stroke="{StaticResource Red}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Footer buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BtnGhost}" Command="{Binding CancelCommand}"
                Margin="0,0,6,0" Padding="10,5" FontSize="12">İptal</Button>
        <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}"
                Padding="14,5" FontSize="12">Kaydet</Button>
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
