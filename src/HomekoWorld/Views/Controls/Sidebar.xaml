<UserControl x:Class="HomekoWorld.Views.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border Width="64" Background="{StaticResource BgPanel}"
          BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
    <DockPanel>

      <!-- Navigation items -->
      <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">

        <!-- Combo Assistant -->
        <Border Margin="6,2" CornerRadius="8" Cursor="Hand" Padding="4,10">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding SelectPageCommand}"
                          CommandParameter="combo"/>
          </Border.InputBindings>
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="BorderBrush"     Value="Transparent"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="combo">
                  <Setter Property="Background"  Value="#1AD4A44A"/>
                  <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource BgHover}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <!-- Combo icon: sword/target shape via text -->
            <TextBlock Text="⚔" FontSize="18" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="combo">
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Kombo" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="combo">
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Oto Farm -->
        <Border Margin="6,2" CornerRadius="8" Cursor="Hand" Padding="4,10">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding SelectPageCommand}"
                          CommandParameter="farm"/>
          </Border.InputBindings>
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="BorderBrush"     Value="Transparent"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="farm">
                  <Setter Property="Background"  Value="#1A4AA4D4"/>
                  <Setter Property="BorderBrush" Value="#FF4488AA"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource BgHover}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🌾" FontSize="18" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="farm">
                      <Setter Property="Foreground" Value="#FF88CCEE"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Oto Farm" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="farm">
                      <Setter Property="Foreground" Value="#FF88CCEE"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Otonom Oyuncu -->
        <Border Margin="6,2" CornerRadius="8" Cursor="Hand" Padding="4,10">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding SelectPageCommand}"
                          CommandParameter="autonomous"/>
          </Border.InputBindings>
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="BorderBrush"     Value="Transparent"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="autonomous">
                  <Setter Property="Background"  Value="#1A9B59D4"/>
                  <Setter Property="BorderBrush" Value="#FFAA66CC"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource BgHover}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="autonomous">
                      <Setter Property="Foreground" Value="#FFCC99EE"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Otonom" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="autonomous">
                      <Setter Property="Foreground" Value="#FFCC99EE"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Yarı-Oto (yakında — devre dışı) -->
        <Border Margin="6,2" CornerRadius="8" Padding="4,10" Opacity="0.4"
                ToolTip="Yarı-Oto (Genie) modu yakında eklenecek.">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="Yarı-Oto" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Alt blok: Ayarlar + aktif göstergesi -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">

        <!-- Ayarlar & Kalibrasyon (mod DEĞİL — SelectedMode'u değiştirmez) -->
        <Border Margin="6,2" CornerRadius="8" Cursor="Hand" Padding="4,10">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding SelectPageCommand}"
                          CommandParameter="settings"/>
          </Border.InputBindings>
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="BorderBrush"     Value="Transparent"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="settings">
                  <Setter Property="Background"  Value="#1AD4A44A"/>
                  <Setter Property="BorderBrush" Value="{StaticResource GoldDeep}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource BgHover}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="settings">
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Ayarlar" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="settings">
                      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Active indicator dot -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource TextDim}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Green}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
      </StackPanel>

    </DockPanel>
  </Border>
</UserControl>
