<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Surfaces ===== -->
  <Color x:Key="BgVoidColor">#FF0A0805</Color>
  <Color x:Key="BgAppColor">#FF14100A</Color>
  <Color x:Key="BgPanelColor">#FF1C1610</Color>
  <Color x:Key="BgPanel2Color">#FF241C14</Color>
  <Color x:Key="BgInsetColor">#FF0F0C08</Color>
  <Color x:Key="BgHoverColor">#FF2A2014</Color>

  <SolidColorBrush x:Key="BgVoid" Color="{StaticResource BgVoidColor}"/>
  <SolidColorBrush x:Key="BgApp" Color="{StaticResource BgAppColor}"/>
  <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}"/>
  <SolidColorBrush x:Key="BgPanel2" Color="{StaticResource BgPanel2Color}"/>
  <SolidColorBrush x:Key="BgInset" Color="{StaticResource BgInsetColor}"/>
  <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}"/>

  <!-- ===== Borders ===== -->
  <Color x:Key="Border1Color">#FF3A2F1F</Color>
  <Color x:Key="Border2Color">#FF4A3C26</Color>
  <Color x:Key="BorderGoldColor">#FF6E5326</Color>
  <Color x:Key="DividerColor">#FF2A2218</Color>

  <SolidColorBrush x:Key="Border1" Color="{StaticResource Border1Color}"/>
  <SolidColorBrush x:Key="Border2" Color="{StaticResource Border2Color}"/>
  <SolidColorBrush x:Key="BorderGold" Color="{StaticResource BorderGoldColor}"/>
  <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}"/>

  <!-- ===== Gold accents ===== -->
  <Color x:Key="GoldColor">#FFD4A44A</Color>
  <Color x:Key="GoldBrightColor">#FFF5D27C</Color>
  <Color x:Key="GoldDeepColor">#FF8B6914</Color>
  <Color x:Key="GoldGlowColor">#59D4A44A</Color>

  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
  <SolidColorBrush x:Key="GoldBright" Color="{StaticResource GoldBrightColor}"/>
  <SolidColorBrush x:Key="GoldDeep" Color="{StaticResource GoldDeepColor}"/>
  <SolidColorBrush x:Key="GoldGlow" Color="{StaticResource GoldGlowColor}"/>

  <!-- ===== Text ===== -->
  <Color x:Key="TextColor">#FFE8DCC0</Color>
  <Color x:Key="TextSoftColor">#FFB8A987</Color>
  <Color x:Key="TextMutedColor">#FF7A6B50</Color>
  <Color x:Key="TextDimColor">#FF5A4F3C</Color>

  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextSoft" Color="{StaticResource TextSoftColor}"/>
  <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>

  <!-- ===== Status ===== -->
  <Color x:Key="RedColor">#FFC44545</Color>
  <Color x:Key="RedBrightColor">#FFE56565</Color>
  <Color x:Key="GreenColor">#FF6BA84F</Color>
  <Color x:Key="GreenBrightColor">#FF8BC46A</Color>
  <Color x:Key="BlueColor">#FF4A7AB8</Color>
  <Color x:Key="PurpleColor">#FF8B5CF6</Color>

  <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
  <SolidColorBrush x:Key="RedBright" Color="{StaticResource RedBrightColor}"/>
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
  <SolidColorBrush x:Key="GreenBright" Color="{StaticResource GreenBrightColor}"/>
  <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}"/>

  <!-- ===== Window ===== -->
  <SolidColorBrush x:Key="Transparent" Color="Transparent"/>
  <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgAppColor}"/>

</ResourceDictionary>
